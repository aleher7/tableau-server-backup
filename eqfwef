SELECT RED_NEGOCIO_VISITA, COUNT(DISTINCT AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 AND UPPER(RED_NEGOCIO_VISITA) LIKE '%PLUS%' <filtro>
GROUP BY RED_NEGOCIO_VISITA;


SELECT COUNT(DISTINCT AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND RED_NEGOCIO_VISITA = 'Red Plus' <filtro>
  AND AGENTE_WID IN (SELECT AGENTE_WID FROM ANL_ACTIVIDAD_ESP
                     WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1);


SELECT COUNT(DISTINCT AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 AND RED_NEGOCIO_VISITA = 'Red Plus';



SELECT DIVISION, TIPO_VISITA, COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026 AND ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL
  AND DIVISION IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')
GROUP BY DIVISION, TIPO_VISITA ORDER BY 1, 2;



SELECT COUNT(*) AS filas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND CONTACTO_WID IS NULL AND F_FICH_AGENTE_CONTACTO = 1;


SELECT RED_NEGOCIO_VISITA, COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL AND DIVISION = 'FORMACIÓN'
GROUP BY RED_NEGOCIO_VISITA ORDER BY 1;


SELECT AÑO, COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL AND DIVISION = 'RED SELECT'
GROUP BY AÑO ORDER BY 1;
