SELECT COUNT(*) AS FILAS_DUPLICADAS
FROM (
    SELECT 1 AS MARCA
    FROM STD_NM_PEDIDOS
    GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID, FACTURA, TIPO_FACTURA
    HAVING COUNT(*) > 1
);



