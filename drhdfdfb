SELECT DISTINCT i.CODIGO_CORTO,
       i.LOCAL_PRODUCT_NAME  nombre_bu_dudosa,
       e.LOCAL_PRODUCT_NAME  nombre_spain_industrial,
       i.BUSINESS_UNIT
FROM   ANL_CDM_INVENTARIO i
JOIN   CLABS_STG_PRO.STG_JDE_IFCSA_F55CVMAE_PIVOT p
       ON TRIM(TO_CHAR(p.COD_CORTO_PROD)) = TRIM(TO_CHAR(i.CODIGO_CORTO))
LEFT JOIN ANL_CDM_INVENTARIO e
       ON e.CODIGO_CORTO = i.CODIGO_CORTO
      AND e.BUSINESS_UNIT IN ('CLABS SPAIN','INDUSTRIAL')
WHERE  i.BUSINESS_UNIT IN ('CLABS MEXICO','CLABS PORTUGAL')
ORDER BY i.BUSINESS_UNIT, i.CODIGO_CORTO;
