SELECT B.NELITM,
       B.NEUPMJ,
       B.NEUPMT,
       TO_DATE(TO_CHAR(1900000 + B.NEUPMJ), 'YYYYDDD') AS FECHA_UPMJ,
       LPAD(B.NEUPMT, 6, '0')                          AS HORA_UPMT,
       get_secuencia_from_julian(B.NEUPMJ)             AS SEC_UPMJ,
       get_secuencia_from_julian(B.NEUPMT)             AS SEC_UPMT,
       CASE WHEN get_secuencia_from_julian(B.NEUPMJ) = get_secuencia_from_julian(B.NEUPMT)
            THEN 'COINCIDEN' ELSE 'NO COINCIDEN' END   AS COMPARACION
FROM CLABS_STG_PRO.STG_JDE_IFCSA_F55NEMPC B
WHERE TRIM(B.NELITM) LIKE '10563%'
ORDER BY B.NEUPMJ DESC, B.NEUPMT DESC;




SELECT CASE WHEN get_secuencia_from_julian(NEUPMJ) = get_secuencia_from_julian(NEUPMT)
            THEN 'COINCIDEN' ELSE 'NO COINCIDEN' END AS COMPARACION,
       COUNT(*) AS FILAS
FROM CLABS_STG_PRO.STG_JDE_IFCSA_F55NEMPC
GROUP BY CASE WHEN get_secuencia_from_julian(NEUPMJ) = get_secuencia_from_julian(NEUPMT)
              THEN 'COINCIDEN' ELSE 'NO COINCIDEN' END;



LEFT JOIN (
    SELECT X.*,
           ROW_NUMBER() OVER (PARTITION BY X.ID_BASE
                              ORDER BY X.NEUPMJ DESC, X.NEUPMT DESC) AS RN
    FROM (
        SELECT B.*,
               SUBSTR(TRIM(B.NELITM), 1, INSTR(TRIM(B.NELITM) || '-', '-') - 1) AS ID_BASE
        FROM CLABS_STG_PRO.STG_JDE_IFCSA_F55NEMPC B
    ) X
) MPC
  ON TRIM(ST.IMLITM) = MPC.ID_BASE
 AND MPC.RN = 1




SELECT DISTINCT TRIM(ST.IMLITM) AS COD_PRODUCTO
FROM CLABS_STG_PRO.STG_SUPPLY_UNHEALTHY_STOCK_CORP ST
WHERE NOT EXISTS (
    SELECT 1
    FROM CLABS_STG_PRO.STG_JDE_IFCSA_F55NEMPC B
    WHERE SUBSTR(TRIM(B.NELITM), 1, INSTR(TRIM(B.NELITM) || '-', '-') - 1) = TRIM(ST.IMLITM)
);
