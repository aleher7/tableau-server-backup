WITH obj AS (
  SELECT MONTH, MAX(OBJETIVO_MED) AS OBJ
  FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE  ORIGEN_TIPO_SF = 'Fichero'
  AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
  AND    ID_CONTACTO_SF = '<ID_CONTACTO>' AND ID_AGENTE = '<ID_AGENTE>'
  AND    TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
  GROUP  BY MONTH
),
vis AS (
  SELECT MONTH, COUNT(DISTINCT ID_SF_VISITA) AS VISITAS
  FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE  ORIGEN_TIPO_SF = 'Visita'
  AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
  AND    FICHERO_FLAG = '1' AND ESTADO_VISITA = 'TERMINADA'
  AND    TIPO_VISITA IN ('VISITA', 'VISITA REMOTA')
  AND    ID_CONTACTO_SF = '<ID_CONTACTO>' AND ID_AGENTE = '<ID_AGENTE>'
  AND    TO_NUMBER(YEAR) = EXTRACT(YEAR FROM SYSDATE - 1)
  AND    TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
  GROUP  BY MONTH
)
SELECT o.MONTH, o.OBJ, TRUNC(o.OBJ) AS OBJ_TABLEAU, NVL(v.VISITAS, 0) AS VISITAS
FROM   obj o
LEFT JOIN vis v ON TO_NUMBER(v.MONTH) = TO_NUMBER(o.MONTH)
ORDER  BY TO_NUMBER(o.MONTH);
