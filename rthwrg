SELECT NVL(RED_NEGOCIO_VISITA, '(null)') AS RED,
       NVL(TIPO, '(null)')    AS TIPO,
       NVL(SUBTIPO, '(null)') AS SUBTIPO,
       COUNT(*)                        AS FILAS,
       COUNT(DISTINCT CONTACTO_WID)    AS CONTACTOS,
       COUNT(ID_VISITA)                AS CON_ID_VISITA,
       COUNT(VISITAS)                  AS CON_VISITAS,
       COUNT(IMPACTOS)                 AS CON_IMPACTOS,
       COUNT(CONTACTOS_VISITADOS_FICHERO) AS CON_FICHERO
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND (RED_NEGOCIO_VISITA IS NULL OR RED_NEGOCIO_VISITA = 'NA')
GROUP BY RED_NEGOCIO_VISITA, TIPO, SUBTIPO
ORDER BY FILAS DESC;


SELECT *
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND RED_NEGOCIO_VISITA IS NULL
  AND ROWNUM <= 20;


SELECT COLUMN_NAME
FROM ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'ANL_ACTIVIDAD_ESP'
  AND (COLUMN_NAME LIKE '%TIPO%' OR COLUMN_NAME LIKE '%ORIGEN%'
       OR COLUMN_NAME LIKE '%FUENTE%' OR COLUMN_NAME LIKE '%EVENTO%'
       OR COLUMN_NAME LIKE '%FICHERO%' OR COLUMN_NAME LIKE '%VISITA%')
ORDER BY COLUMN_NAME;
