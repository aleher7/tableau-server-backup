SELECT lado, FECHA_VISITA, ORIGEN_TIPO_SF, FLAG_DIA, FLAG_DIA_FICHERO,
       FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV
FROM (
  SELECT 'SOLO_NUEVA' AS lado, x.* FROM (
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM nueva
    MINUS
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM base) x
  UNION ALL
  SELECT 'SOLO_BASE', y.* FROM (
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM base
    MINUS
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM nueva) y
)
ORDER BY FECHA_VISITA, lado
FETCH FIRST 20 ROWS ONLY;
