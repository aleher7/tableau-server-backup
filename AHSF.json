SELECT o.PT_CLASIFICACION_CONT, o.OBJETIVO_ESPERADO,
       a.OBJ_MIN_TABLA, a.OBJ_MAX_TABLA
FROM (SELECT PT_CLASIFICACION_CONT, SUM(OBJETIVO_MED) AS OBJETIVO_ESPERADO
      FROM CLABS_ANL_PRO.ANL_PT_F_OBJETIVOS_COB
      WHERE CICLO || '_' || FASE IN ('C1_F1','C1_F2','C2_F1','C2_F2')
      GROUP BY PT_CLASIFICACION_CONT) o
LEFT JOIN (SELECT f.PT_CLASIFICACION_CONT,
                  MIN(x.OBJETIVO_MED) AS OBJ_MIN_TABLA, MAX(x.OBJETIVO_MED) AS OBJ_MAX_TABLA
           FROM CLABS_ANL_PRO.ANL_PT_AUX_COLOR_CONTACTO x
           JOIN CLABS_ANL_PRO.ANL_PT_M_FICHERO f
             ON f.ID_CONTACTO_SF = x.ID_CONTACTO_SF AND f.ID_AGENTE_SF = x.ID_AGENTE_SF
           GROUP BY f.PT_CLASIFICACION_CONT) a
  ON a.PT_CLASIFICACION_CONT = o.PT_CLASIFICACION_CONT
ORDER BY 1;


SELECT * FROM CLABS_ANL_PRO.ANL_PT_AUX_COLOR_CONTACTO WHERE ROWNUM <= 20;



SELECT COUNT(DISTINCT ID_SF_VISITA) AS VISITAS
FROM CLABS_ANL_PRO.ANL_PT_F_ACTIVIDAD
WHERE ID_CONTACTO_SF = '<ID_CONTACTO>'
  AND ID_AGENTE_SF = '<ID_AGENTE>'
  AND ESTADO_VISITA = 'TERMINADA'
  AND ORIGEN_TIPO_SF = 'Visita'
  AND TIPO_VISITA IN ('VISITA REMOTA','VISITA','VISITA COMPLETA')
  AND FICHERO_FLAG = '1'
  AND RED_USUARIO IN (<copia aquí la lista exacta del FILTER>)
  AND substr(FECHA_VISITA,1,4) = TO_CHAR(SYSDATE - 1, 'YYYY')
  AND substr(FECHA_VISITA,5,2) BETWEEN '01' AND '08';



  SELECT COLOR_CICLO, COUNT(*) FROM CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE YEAR = '2026' GROUP BY COLOR_CICLO;
