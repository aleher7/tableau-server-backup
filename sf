SELECT *
FROM (
  SELECT p.ID_AGENTE, p.ID_CONTACTO_SF,
         NVL(v.VISITAS, 0)         AS VISITAS,
         TRUNC(NVL(o.OBJETIVO, 0)) AS OBJETIVO,
         CASE WHEN NVL(v.VISITAS, 0) > 0
               AND NVL(v.VISITAS, 0) >= TRUNC(NVL(o.OBJETIVO, 0))
              THEN 'Objetivo Alcançado' ELSE 'Objetivo não Alcançado' END AS ESTADO,
         CASE WHEN TRUNC(NVL(o.OBJETIVO, 0)) = 0 THEN 'Sin objetivo' ELSE 'Con objetivo' END AS TIENE_OBJ,
         ROW_NUMBER() OVER (
           PARTITION BY CASE WHEN NVL(v.VISITAS, 0) > 0
                              AND NVL(v.VISITAS, 0) >= TRUNC(NVL(o.OBJETIVO, 0))
                             THEN 1 ELSE 0 END,
                        CASE WHEN TRUNC(NVL(o.OBJETIVO, 0)) = 0 THEN 1 ELSE 0 END
           ORDER BY NVL(v.VISITAS, 0) DESC) AS RN
  FROM   parejas p
  LEFT JOIN obj o ON o.ID_CONTACTO_SF = p.ID_CONTACTO_SF AND o.ID_AGENTE = p.ID_AGENTE
  LEFT JOIN vis v ON v.ID_CONTACTO_SF = p.ID_CONTACTO_SF AND v.ID_AGENTE = p.ID_AGENTE
)
WHERE RN = 1;
