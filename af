SELECT SDKCOO                AS COMPANIA,
       COUNT(*)              AS FILAS,
       COUNT(DISTINCT PEDIDO) AS PEDIDOS
FROM STD_NM_PEDIDOS
GROUP BY SDKCOO
ORDER BY SDKCOO;


SELECT SDKCOO                AS COMPANIA,
       COUNT(*)              AS FILAS,
       COUNT(DISTINCT SDDOCO) AS PEDIDOS,
       MAX(SDADDJ)           AS ULTIMA_FECHA_JUL
FROM TMP_3_NMACST_F4211_F421x
GROUP BY SDKCOO
ORDER BY SDKCOO;


SELECT CCCO   AS COMPANIA,
       CCNAME AS NOMBRE
FROM F0010
WHERE UPPER(CCNAME) LIKE '%NDL%';


SELECT ABAN8 AS CLIENTE,
       ABALPH AS NOMBRE
FROM STG_JDE_NMACST_F0101_AD
WHERE UPPER(ABALPH) LIKE '%NDL%';
