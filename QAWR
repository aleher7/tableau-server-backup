SELECT COUNT(*) AS PEDIDOS_CON_CLIENTE,
       SUM(CASE WHEN C.CLIENTE IS NULL THEN 1 ELSE 0 END) AS PEDIDOS_SIN_FICHA,
       COUNT(DISTINCT CASE WHEN C.CLIENTE IS NULL THEN P.CLIENTE END) AS CLIENTES_SIN_FICHA
FROM PEDIDOS P
LEFT JOIN CLIENTES C
       ON TO_CHAR(C.CLIENTE) = TO_CHAR(P.CLIENTE)
WHERE P.CLIENTE IS NOT NULL;


SELECT DISTINCT P.CLIENTE AS CLIENTE_SIN_FICHA
FROM PEDIDOS P
WHERE P.CLIENTE IS NOT NULL
  AND NOT EXISTS (
      SELECT 1
      FROM CLIENTES C
      WHERE TO_CHAR(C.CLIENTE) = TO_CHAR(P.CLIENTE)
  )
ORDER BY 1;


SELECT DISTINCT TO_CHAR(CLIENTE) AS CLIENTE_SIN_FICHA
FROM PEDIDOS
WHERE CLIENTE IS NOT NULL
MINUS
SELECT TO_CHAR(CLIENTE)
FROM CLIENTES;
