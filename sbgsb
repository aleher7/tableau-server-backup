SELECT COUNT(*) FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW;

SELECT COUNT(*) FROM anl_m_prod_catalog_local l
JOIN anl_m_prod_catalog_corp c ON l.grouped_gold_code = c.grouped_gold_code;


SELECT BUSINESS_UNIT, COUNT(*) - COUNT(DISTINCT LOCAL_PRODUCT_CODE) AS DUP
FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW GROUP BY BUSINESS_UNIT;


SELECT LOCAL_GROUPED_PRODUCT_CODE, COUNT(*) FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW
WHERE BUSINESS_UNIT='ESP' GROUP BY LOCAL_GROUPED_PRODUCT_CODE HAVING COUNT(*) > 1;
