SELECT ID_VISITA,ID_SF_VISITA,AÑO,MES,DIA,Tipo_Visita,Subtipo_Visita,Visita_CLM,Estado_Visita,
Division,Gerente,Agente_WID,Contacto_WID,Agente,Cd_Delegado_Jde, Estado_Agente, Nombre_Apellido_Contacto, Estatus_Especialidad, Especialidad_Principal, Especialidad_Resumen, 
