SELECT f.NUM_PEDIDO, f.ID_ITM, f.DCTO_COMERCIAL AS final, c.esperado,
       f.DCTO_COMERCIAL - c.esperado AS diferencia
FROM (
  SELECT TO_CHAR(SDDOCO) || TO_CHAR(SDDCTO) AS NUM_PEDIDO, SDITM,
         SUM(SDSOQS/10000 * ALUPRC_DESC/10000 * (-1)) AS esperado
  FROM TMP_4_NDL_PED_CAMPOS
  WHERE SDKCOO = '00400'
    AND SDDCTO IN ('SO','SN','CC')
    AND ALUPRC_DESC IS NOT NULL
    AND TRIM(TIPO_DESC) NOT LIKE 'STADPP%'
  GROUP BY TO_CHAR(SDDOCO) || TO_CHAR(SDDCTO), SDITM
) c
JOIN STD_NDL_PEDIDOS_NORM f
  ON f.NUM_PEDIDO = c.NUM_PEDIDO AND f.ID_ITM = c.SDITM
WHERE ABS(f.DCTO_COMERCIAL - c.esperado) > 0.01
ORDER BY ABS(f.DCTO_COMERCIAL - c.esperado) DESC;


SELECT SDDCTO AS tipo,
       SUM(SDSOQS/10000 * ALUPRC_DESC/10000 * (-1)) AS descuento_en_origen
FROM TMP_4_NDL_PED_CAMPOS
WHERE SDKCOO = '00400' AND ALUPRC_DESC IS NOT NULL
GROUP BY SDDCTO ORDER BY 1;

SELECT SUBSTR(NUM_PEDIDO,-2) AS tipo,
       SUM(IMPORTE_BRUTO) AS bruto, SUM(IMPORTE_NETO) AS neto,
       SUM(TOTAL_DESCUENTO) AS descuento_cargado
FROM STD_NDL_PEDIDOS_NORM
GROUP BY SUBSTR(NUM_PEDIDO,-2) ORDER BY 1;


SELECT SUBSTR(NUM_PEDIDO,-2) AS tipo, MIN(NUM_PEDIDO) AS ejemplo
FROM STD_NDL_PEDIDOS_NORM
WHERE SUBSTR(NUM_PEDIDO,-2) IN ('SA','S9','SR')
GROUP BY SUBSTR(NUM_PEDIDO,-2);


SELECT NUM_PEDIDO, ID_ITM, UNIDADES_NETAS, PRECIO_NETO, IMPORTE_BRUTO, IMPORTE_NETO,
       IMPORTE_CON_DESCUENTO, TOTAL_DESCUENTO
FROM STD_NDL_PEDIDOS_NORM
WHERE NUM_PEDIDO = '<ejemplo>';
