SELECT NVL(o.ID_PEDIDO, c.ID_PEDIDO)   AS ID_PEDIDO,
       NVL(o.ID_CAMPANA, c.ID_CAMPANA) AS ID_CAMPANA,
       o.LINEAS  AS LINEAS_ORIGEN,
       c.LINEAS  AS LINEAS_CAMPANAS,
       o.UB      AS UB_ORIGEN,
       c.UB      AS UB_CAMPANAS,
       o.IMP     AS IMP_ORIGEN,
       c.IMP     AS IMP_CAMPANAS,
       c.UB  - NVL(o.UB,0)  AS DIF_UB,
       c.IMP - NVL(o.IMP,0) AS DIF_IMP
FROM (SELECT ID_PEDIDO, ID_CAMPANA,
             COUNT(*) LINEAS,
             SUM(UNIDADES_BRUTAS) UB,
             SUM(IMPORTE_NETO)    IMP
      FROM ANL_F_SELLIN
      WHERE ID_BU = 'ESP'
        AND ID_PEDIDO IN ('25107862SO','25103285SO','25083608SO')
      GROUP BY ID_PEDIDO, ID_CAMPANA) o
FULL OUTER JOIN
     (SELECT ID_PEDIDO, ID_CAMPANA,
             COUNT(*) LINEAS,
             SUM(UNIDADES_BRUTAS) UB,
             SUM(IMPORTE_NETO)    IMP
      FROM ANL_ANALISIS_CAMPAÑAS_ESP
      WHERE DATA_SOURCE = 1
        AND ID_PEDIDO IN ('25107862SO','25103285SO','25083608SO')
      GROUP BY ID_PEDIDO, ID_CAMPANA) c
  ON o.ID_PEDIDO = c.ID_PEDIDO
 AND o.ID_CAMPANA = c.ID_CAMPANA
ORDER BY 1, 2;
