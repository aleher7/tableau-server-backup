SELECT 1900 + TRUNC(T.FECHA_JUL / 1000) AS ANIO,
       COUNT(*)                         AS FILAS,
       COUNT(DISTINCT P.PEDIDO)         AS PEDIDOS,
       COUNT(DISTINCT P.FACTURA)        AS FACTURAS,
       COUNT(DISTINCT P.SDAN8)          AS CLIENTES
FROM STD_NM_PEDIDOS P
JOIN (
    SELECT SDDOCO      AS PEDIDO,
           MAX(SDADDJ) AS FECHA_JUL
    FROM TMP_3_NMACST_F4211_F421x
    GROUP BY SDDOCO
) T
  ON TO_CHAR(T.PEDIDO) = TO_CHAR(P.PEDIDO)
GROUP BY 1900 + TRUNC(T.FECHA_JUL / 1000)
ORDER BY 1;




