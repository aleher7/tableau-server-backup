WITH base AS (
    SELECT a.*,
           CASE WHEN AÑO = '2026' THEN 1 END AS EN_PERIODO,
           MAX(CASE WHEN F_FICH_AGENTE_CONTACTO > 0 THEN AGENTE END)
             OVER (PARTITION BY AGENTE_WID, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN,
                                ESPECIALIDAD_PRINCIPAL, TIPO, SUBTIPO, PERFIL) AS AGENTE_FICHERO
    FROM ANL_ACTIVIDAD_ESP a
    WHERE AÑO >= '2024'
      AND (   ID_VISITA IS NULL
           OR CONTACTO_WID IS NOT NULL
           OR DIVISION IS NULL
           OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
),
k AS (
    SELECT CASE WHEN GROUPING(RED_NEGOCIO_VISITA) = 1 THEN 'TOTAL'
                ELSE NVL(TO_CHAR(RED_NEGOCIO_VISITA), '(null)') END AS RED,
           COUNT(DISTINCT AGENTE_FICHERO) AS agentes_fichero_tab,
           COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO > 0 AND EN_PERIODO = 1
                               THEN AGENTES_VISITADOS END) AS agentes_con_visita,
           COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
                               THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS f,
           COUNT(DISTINCT CASE WHEN EN_PERIODO = 1 THEN VISITAS END) AS visitas,
           COUNT(DISTINCT CASE WHEN EN_PERIODO = 1 THEN DIAS_TRABAJADOS_AGENTES END) AS dias_trabajados
    FROM base
    GROUP BY ROLLUP (RED_NEGOCIO_VISITA)
)
SELECT k.*,
       ROUND(100 * agentes_con_visita / NULLIF(agentes_fichero_tab, 0), 1) AS pct_agentes,
       TRUNC(f / NULLIF(agentes_fichero_tab, 0))                           AS fichero_m,
       ROUND(visitas / NULLIF(dias_trabajados, 0), 2)                      AS media_visitas
FROM k
ORDER BY CASE WHEN RED = 'TOTAL' THEN 1 ELSE 0 END, RED;
