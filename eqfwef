SELECT COUNT(DISTINCT AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 AND DIVISION = 'RED PLUS'
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
