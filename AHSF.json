            if fecha_oracle is None:
                log.error("No se puede confirmar la fecha de actualizacion en Oracle "
                          "(revisa la conexion o la consulta; el error concreto aparece "
                          "mas arriba)")
                resultados['error'].extend(i['nombre'] for i in pendientes)
            elif fecha_oracle != hoy:
                log.warning("DESCARTADO: Oracle dice %s (hoy es %s) -- la carga del dia "
                            "todavia no ha llegado", fecha_oracle.strftime('%d/%m/%Y'),
                            hoy.strftime('%d/%m/%Y'))
                resultados['descartado'].extend(i['nombre'] for i in pendientes)
            else:
                log.info("Oracle confirma que los datos estan al dia (%s)",
                         hoy.strftime('%d/%m/%Y'))
                # Tableau solo informa: si Oracle esta bien, se sigue adelante.
                if fecha_tableau is None:
                    log.warning("No se pudo leer la fecha del extracto en Tableau; se continua "
                                "porque Oracle esta al dia")
                elif fecha_tableau != hoy:
                    log.warning("El extracto de Tableau indica %s (no es hoy); se continua "
                                "porque Oracle esta al dia. El CSV podria traer datos "
                                "anteriores.", fecha_tableau.strftime('%d/%m/%Y'))

                listos = []     # [(informe, ruta), ...] listos en esta pasada
                for numero, informe in enumerate(pendientes, start=1):
                    log.info("[%d/%d] %s", numero, len(pendientes), informe['nombre'])
                    estado_informe, ruta = preparar_informe(servidor, config, informe, hoy)
                    if estado_informe == 'listo':
                        listos.append((informe, ruta))
                    else:
                        resultados['error'].append(informe['nombre'])

                if resultados['error']:
                    log.warning("No se envia ningun correo esta pasada: no se pudo generar %s",
                                ", ".join(resultados['error']))
                elif not enviar:
                    for informe, ruta in listos:
                        log.info("        (modo --sin-enviar) CSV generado en %s", ruta)
                    resultados['enviado'].extend(informe['nombre'] for informe, _ in listos)
                else:
                    resultados_envio = enviar_lote(config, listos, hoy, estado, hoy_txt)
                    for nombre, resultado in resultados_envio.items():
                        resultados[resultado].append(nombre)



            except Exception as e:
                log.warning("No se pudo comprobar la fecha en Tableau (via '%s'): %s",
                            informe_referencia['nombre'], e)
