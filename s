SELECT table_name, column_name
FROM all_tab_columns
WHERE owner = 'CLABS_ANL_PRO'
  AND table_name IN ('ANL_M_PROD_CATALOG_LOCAL','ANL_M_PROD_CATALOG_CORP')
  AND (column_name LIKE '%\_NEW' ESCAPE '\' OR column_name IN
       ('LOCAL_PROD_CODE_BCK','FIRST_ORDER_S','EXPIRED_DATE_L','PAO_L','LAUNCH_YEAR_L','LAUNCH_MONTH_L'));



       SELECT BUSINESS_UNIT, COUNT(*)
FROM ANL_M_PROD_CATALOG_LOCAL
  AS OF TIMESTAMP TO_TIMESTAMP('14/10/2026 09:00','DD/MM/YYYY HH24:MI')
GROUP BY BUSINESS_UNIT
ORDER BY 1;
