WITH parejas AS (
    SELECT agente_wid,
           contacto_wid,
           MAX(NVL(f_fich_agente_contacto, 0)) AS en_fichero,
           MAX(CASE WHEN visitas IS NOT NULL THEN 1 ELSE 0 END) AS visitado,
           MAX(CASE WHEN visitas IS NULL
                     AND (id_visita IS NOT NULL OR id_sf_act IS NOT NULL)
                    THEN 1 ELSE 0 END) AS otra_actividad
    FROM anl_actividad_esp
    WHERE contacto_wid IS NOT NULL
    GROUP BY agente_wid, contacto_wid
)
SELECT CASE WHEN en_fichero = 1 THEN 'Dentro del fichero'
            ELSE 'Fuera del fichero' END AS ambito,
       COUNT(*) AS total_contactos,
       SUM(visitado) AS visitados,
       SUM(CASE WHEN visitado = 0 AND otra_actividad = 1 THEN 1 ELSE 0 END) AS solo_otra_actividad,
       SUM(CASE WHEN visitado = 0 AND otra_actividad = 0 THEN 1 ELSE 0 END) AS sin_visitar_sin_actividad
FROM parejas
GROUP BY CASE WHEN en_fichero = 1 THEN 'Dentro del fichero'
              ELSE 'Fuera del fichero' END;



