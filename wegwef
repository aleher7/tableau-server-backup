SELECT a.SUBTIPO_VISITA,
       NVL(a.ESTADO_VISITA, '(null)') AS ESTADO_VISITA,
       CASE WHEN a.CONTACTO_WID IS NULL THEN 'Sin contacto' ELSE 'Con contacto' END AS CONTACTO,
       COUNT(DISTINCT CASE WHEN a.VISITAS IS NOT NULL THEN a.ID_VISITA END) AS CONTADAS,
       COUNT(DISTINCT CASE WHEN a.VISITAS IS NULL     THEN a.ID_VISITA END) AS NO_CONTADAS
FROM ANL_ACTIVIDAD_ESP a
WHERE a.AÑO = '2026'
  AND a.TIPO_VISITA = 'Llamada telefónica'
  AND a.ID_VISITA IS NOT NULL
  AND a.RED_NEGOCIO_VISITA IS NOT NULL
  AND a.RED_NEGOCIO_VISITA <> 'NA'
GROUP BY a.SUBTIPO_VISITA, a.ESTADO_VISITA,
         CASE WHEN a.CONTACTO_WID IS NULL THEN 'Sin contacto' ELSE 'Con contacto' END
ORDER BY a.SUBTIPO_VISITA, NO_CONTADAS DESC;



SELECT DISTINCT ID_VISITA, AGENTE, MES, SUBTIPO_VISITA, DIVISION, CONTACTO_WID, ESTADO_VISITA
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND TIPO_VISITA = 'Visita Presencial'
  AND SUBTIPO_VISITA IN ('Visita comercial', 'Prospección')
  AND VISITAS IS NULL
  AND (RED_NEGOCIO_VISITA IS NULL OR RED_NEGOCIO_VISITA = 'NA');
