      WHEN (EXTRACT(YEAR FROM SYSDATE)-1)=CAST(SUBSTR(FECHA,1,4) AS NUMBER) AND CAST(SUBSTR(FECHA,5,2) AS NUMBER) = EXTRACT(MONTH FROM SYSDATE) AND EXTRACT(DAY FROM TO_DATE(SUBSTR(FECHA,1,4)||'-'||SUBSTR(A.FECHA,5,2)||'-'||SUBSTR(A.FECHA,7,2), 'YYYY-MM-DD'))<= EXTRACT(DAY FROM SYSDATE)
