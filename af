SELECT COUNT(DISTINCT ID_CONTACTO_SF || '|' || ID_AGENTE) AS PAREJAS_BLANCO_TOTAL,
       COUNT(DISTINCT CASE WHEN UPPER(TIPO_RED) LIKE '%MEDICA%'
                           THEN ID_CONTACTO_SF || '|' || ID_AGENTE END) AS PAREJAS_BLANCO_MEDICA
FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
WHERE  COLOR_CICLO = 'Blanco';
