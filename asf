SELECT R.FILAS,
       R.PEDIDOS,
       R.CON_FACTURA,
       K.CLAVES_REPETIDAS
FROM (
    SELECT COUNT(*)                AS FILAS,
           COUNT(DISTINCT PEDIDO)  AS PEDIDOS,
           COUNT(FACTURA)          AS CON_FACTURA
    FROM STD_NM_PEDIDOS
) R
CROSS JOIN (
    SELECT COUNT(*) AS CLAVES_REPETIDAS
    FROM (
        SELECT 1 AS MARCA
        FROM STD_NM_PEDIDOS
        GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID
        HAVING COUNT(*) > 1
    )
) K;


