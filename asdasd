-- 3. Comparación (cuenta apariciones, así detecta también duplicados)
WITH a AS (SELECT AÑO, MES, PRODUCT_CODE, UNIDADES_ROLLING, VUELTA, COUNT(*) veces
           FROM tmp_r12_actual GROUP BY AÑO, MES, PRODUCT_CODE, UNIDADES_ROLLING, VUELTA),
     n AS (SELECT AÑO, MES, PRODUCT_CODE, UNIDADES_ROLLING, VUELTA, COUNT(*) veces
           FROM tmp_r12_nueva  GROUP BY AÑO, MES, PRODUCT_CODE, UNIDADES_ROLLING, VUELTA)
SELECT 'SOLO_ACTUAL' origen, x.* FROM (SELECT * FROM a MINUS SELECT * FROM n) x
UNION ALL
SELECT 'SOLO_NUEVA',         y.* FROM (SELECT * FROM n MINUS SELECT * FROM a) y
ORDER BY VUELTA, AÑO, MES, PRODUCT_CODE;
