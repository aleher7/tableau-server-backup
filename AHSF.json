
WITH vis AS (
  SELECT ID_CONTACTO_SF, ID_AGENTE, COUNT(DISTINCT ID_SF_VISITA) AS VISITAS
  FROM CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE YEAR = TO_CHAR(SYSDATE - 1, 'YYYY')
    AND TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
    AND FICHERO_FLAG = '1' AND ESTADO_VISITA = 'TERMINADA'
    AND ORIGEN_TIPO_SF = 'Visita' AND TIPO_VISITA IN ('VISITA','VISITA REMOTA')
  GROUP BY ID_CONTACTO_SF, ID_AGENTE),
obj AS (
  SELECT ID_CONTACTO_SF, ID_AGENTE, TRUNC(SUM(OBJ)) AS OBJETIVO
  FROM (SELECT ID_CONTACTO_SF, ID_AGENTE, MONTH, PT_CLASIFICACION_CONT, MAX(OBJETIVO_MED) AS OBJ
        FROM CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
        WHERE TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
          AND OBJETIVO_MED IS NOT NULL
        GROUP BY ID_CONTACTO_SF, ID_AGENTE, MONTH, PT_CLASIFICACION_CONT)
  GROUP BY ID_CONTACTO_SF, ID_AGENTE)
SELECT CASE WHEN NVL(v.VISITAS,0) >= NVL(o.OBJETIVO,0) THEN 'Alcançado' ELSE 'não Alcançado' END AS ESTADO,
       COUNT(*) AS PAREJAS
FROM obj o
LEFT JOIN vis v ON v.ID_CONTACTO_SF = o.ID_CONTACTO_SF AND v.ID_AGENTE = o.ID_AGENTE
GROUP BY CASE WHEN NVL(v.VISITAS,0) >= NVL(o.OBJETIVO,0) THEN 'Alcançado' ELSE 'não Alcançado' END;
