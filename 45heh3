SELECT RED_NEGOCIO_VISITA, TIPO_VISITA,
       CASE WHEN IMPACTOS IS NOT NULL THEN 'con producto'
            WHEN VISITAS_SIN_PRODUCTO IS NOT NULL THEN 'sin producto'
            ELSE 'no cuenta' END AS producto,
       COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO = 2025 AND MES BETWEEN 2 AND 7 AND ID_VISITA IS NOT NULL <filtro>
GROUP BY RED_NEGOCIO_VISITA, TIPO_VISITA,
         CASE WHEN IMPACTOS IS NOT NULL THEN 'con producto'
              WHEN VISITAS_SIN_PRODUCTO IS NOT NULL THEN 'sin producto'
              ELSE 'no cuenta' END
ORDER BY 1, 2, 3;
