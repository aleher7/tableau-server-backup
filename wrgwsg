SELECT NVL(RED_NEGOCIO_VISITA,'(NULL)') AS red, COUNT(*) AS parejas
FROM (SELECT DISTINCT RED_NEGOCIO_VISITA, CONTACTO_WID
      FROM ANL_ACTIVIDAD_ESP
      WHERE AGENTE_WID = <id> AND F_FICH_AGENTE_CONTACTO = 1 AND AÑO >= 2024
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')))
GROUP BY NVL(RED_NEGOCIO_VISITA,'(NULL)') ORDER BY 1;


SELECT DIVISION, COUNT(*) AS filas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO >= 2024
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY DIVISION;


SELECT AÑO, MES, RED_NEGOCIO_VISITA, DIVISION,
       COUNT(DISTINCT ID_VISITA) AS visitas_totales, COUNT(DISTINCT VISITAS) AS visitas_contadas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO >= 2024 AND ID_VISITA IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY AÑO, MES, RED_NEGOCIO_VISITA, DIVISION ORDER BY 1, 2, 3;



SELECT AÑO,
       CASE WHEN ID_VISITA IS NULL THEN 'sin ID_VISITA' ELSE 'con ID_VISITA' END AS tipo_fila,
       DIVISION, RED_NEGOCIO_VISITA, F_FICH_AGENTE_CONTACTO,
       COUNT(*) AS filas, COUNT(DISTINCT VISITAS) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <agente> AND CONTACTO_WID = <contacto> AND AÑO >= 2024
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY AÑO,
         CASE WHEN ID_VISITA IS NULL THEN 'sin ID_VISITA' ELSE 'con ID_VISITA' END,
         DIVISION, RED_NEGOCIO_VISITA, F_FICH_AGENTE_CONTACTO
ORDER BY 1, 2, 4;



-- Actual (por división)
SELECT DIVISION, COUNT(*) AS parejas
FROM (SELECT DISTINCT DIVISION, AGENTE_WID, CONTACTO_WID
      FROM ANL_ACTIVIDAD_ESP
      WHERE AGENTE_WID = <agente> AND CONTACTO_WID = <contacto>
        AND AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')))
GROUP BY DIVISION;

-- Histórica (por red)
SELECT NVL(RED_NEGOCIO_VISITA,'(NULL)') AS red, COUNT(*) AS parejas
FROM (SELECT DISTINCT RED_NEGOCIO_VISITA, AGENTE_WID, CONTACTO_WID
      FROM ANL_ACTIVIDAD_ESP
      WHERE AGENTE_WID = <agente> AND CONTACTO_WID = <contacto>
        AND AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')))
GROUP BY NVL(RED_NEGOCIO_VISITA,'(NULL)');


SELECT CONTACTO_WID, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <agente> AND AÑO >= 2024 AND ID_VISITA IS NOT NULL
  AND RED_NEGOCIO_VISITA <> 'NA' AND CONTACTO_WID IS NOT NULL
GROUP BY CONTACTO_WID HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) >= 3
ORDER BY 1;
