SELECT c.ID_SF_VISITA, c.ID_CONTACTO_SF, c.FECHA_VISITA,
       c.VALENCIA1 AS valencia1_contactos,
       a.VALENCIA1 AS valencia1_actividad
FROM CLABS_ANL_PRO.MV_CNT c
JOIN CLABS_ANL_PRO.MV_ACT a ON a.ID_SF_VISITA = c.ID_SF_VISITA
WHERE c.ORIGEN_TIPO_SF = 'Visita'
  AND (c.VALENCIA1 <> a.VALENCIA1
       OR (c.VALENCIA1 IS NULL AND a.VALENCIA1 IS NOT NULL)
       OR (c.VALENCIA1 IS NOT NULL AND a.VALENCIA1 IS NULL))
FETCH FIRST 50 ROWS ONLY;



SELECT 'CNT' mv, ORIGEN_TIPO_SF, COUNT(*) filas, COUNT(VALENCIA1) con_valor
FROM CLABS_ANL_PRO.MV_CNT GROUP BY ORIGEN_TIPO_SF
UNION ALL
SELECT 'ACT', ORIGEN_TIPO_SF, COUNT(*), COUNT(VALENCIA1)
FROM CLABS_ANL_PRO.MV_ACT GROUP BY ORIGEN_TIPO_SF;
