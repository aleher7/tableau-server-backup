SELECT
    RED_NEGOCIO_VISITA,
    SEGMENTO,
    CV,
    V,
    ROUND(V / NULLIF(CV, 0), 2) AS FR     -- frecuencia: visitas / visitados
FROM (
    SELECT
        DIVISION AS RED_NEGOCIO_VISITA,
        CASE WHEN GROUPING(SEGMENTO) = 1 THEN 'TOTAL' ELSE SEGMENTO END AS SEGMENTO,

        -- CV: contactos visitados (opción '2' = histórico)
        COUNT(DISTINCT CASE WHEN CONTACTOS_VISITADOS IS NOT NULL
                            THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS CV,

        -- V: visitas (SUPUESTO, cámbialo por tu fórmula)
        COUNT(DISTINCT VISITAS) AS V
    FROM ANL_ACTIVIDAD_ESP2
    WHERE AÑO = '2026'
      -- resto de filtros de la hoja de Tableau
    GROUP BY GROUPING SETS (
        (DIVISION, SEGMENTO),   -- celdas por segmento
        (DIVISION)              -- columna Total
    )
)
ORDER BY RED_NEGOCIO_VISITA NULLS FIRST,
         CASE WHEN SEGMENTO = 'TOTAL' THEN 0 ELSE 1 END,
         SEGMENTO;
