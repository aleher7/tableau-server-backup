SELECT COUNT(*) AS contactos_mes_con_2_redes
FROM (SELECT CONTACTO_WID, AÑO, MES FROM ANL_ACTIVIDAD_ESP
      WHERE AGENTE_WID = <id> AND ID_VISITA IS NOT NULL AND RED_NEGOCIO_VISITA <> 'NA' <filtro>
      GROUP BY CONTACTO_WID, AÑO, MES HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1);


SELECT RED_NEGOCIO_VISITA, TIPO_VISITA,
       CASE WHEN PRODUCTO_REPORTE_WID > 0 THEN 'con producto' ELSE 'sin producto' END AS producto,
       COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO = 2025 AND MES BETWEEN 2 AND 7 AND ID_VISITA IS NOT NULL <filtro>
GROUP BY RED_NEGOCIO_VISITA, TIPO_VISITA,
         CASE WHEN PRODUCTO_REPORTE_WID > 0 THEN 'con producto' ELSE 'sin producto' END
ORDER BY 1, 2, 3;


SELECT DIVISION, COUNT(DISTINCT ID_VISITA) AS filas_na,
       COUNT(DISTINCT CASE WHEN CONTACTO_WID IS NULL THEN ID_VISITA END) AS sin_contacto
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL AND RED_NEGOCIO_VISITA = 'NA'
GROUP BY DIVISION ORDER BY 1;
