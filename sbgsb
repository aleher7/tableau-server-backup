-- Duplicados: la vista debería devolver filas y el join, ninguna
SELECT COUNT(*) - COUNT(DISTINCT LOCAL_PRODUCT_CODE) FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW WHERE BUSINESS_UNIT='ESP';

SELECT COUNT(*) - COUNT(DISTINCT l.LOCAL_PRODUCT_CODE) FROM anl_m_prod_catalog_local l
JOIN anl_m_prod_catalog_corp c ON l.grouped_gold_code = c.grouped_gold_code WHERE BUSINESS_UNIT='ESP';

-- Mismo contenido (distinct) en ambos sentidos: debe dar 0 filas
SELECT DISTINCT LOCAL_GROUPED_PRODUCT_CODE FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW WHERE BUSINESS_UNIT='ESP' AND plan_year_launch IS NOT NULL AND LOCAL_GROUPED_PRODUCT_CODE=LOCAL_PRODUCT_CODE
MINUS
SELECT DISTINCT LOCAL_GROUPED_PRODUCT_CODE FROM anl_m_prod_catalog_local l JOIN anl_m_prod_catalog_corp c ON l.grouped_gold_code = c.grouped_gold_code WHERE BUSINESS_UNIT='ESP' AND plan_year_launch IS NOT NULL AND LOCAL_GROUPED_PRODUCT_CODE=LOCAL_PRODUCT_CODE;
