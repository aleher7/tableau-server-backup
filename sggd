WITH base AS (
    SELECT *
    FROM anl_actividad_esp
    WHERE "AÑO" = 2026
      AND mes <= 10          -- ajusta al periodo de [Periodo Actual]
      -- Filtro Contacto No nulo = 'True'
      AND NOT (id_visita IS NOT NULL
               AND contacto_wid IS NULL
               AND NVL(division, '#') IN ('RED NEO', 'RED PLUS', 'RED SKIN',
                                          'RED DERM', 'RED CARE'))
)
SELECT
    COUNT(DISTINCT agentes_visitados) AS agentes_con_visita,           -- esperado 178
    COUNT(DISTINCT CASE WHEN contactos_visitados IS NOT NULL
                        THEN agente_wid || '|' || contacto_wid END)
                                       AS contactos_visitados,          -- esperado 31.701
    COUNT(DISTINCT contactos_visitados) AS contactos_unicos,            -- esperado 13.932
    COUNT(DISTINCT CASE WHEN contactos_visitados_fichero IS NOT NULL
                        THEN agente_wid || '|' || contacto_wid END)
                                       AS contactos_visitados_fichero,  -- esperado 22.401
    COUNT(DISTINCT visitas)            AS visitas,                      -- esperado 136.354
    COUNT(DISTINCT visitas_fichero)    AS visitas_fichero               -- esperado 113.044
FROM base;
