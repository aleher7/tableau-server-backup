SELECT COUNT(*) AS CLAVES_REPETIDAS
FROM (
    SELECT 1 AS MARCA
    FROM STD_NM_PEDIDOS
    GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID
    HAVING COUNT(*) > 1
);


----------------------------

SELECT SDKCOO AS COMPANIA,
       SDDOCO AS PEDIDO,
       SDDCTO AS TIPO_PEDIDO,
       SDLNID AS LINEA,
       SDITM  AS ARTICULO,
       SDDOC  AS FACTURA,
       SDDCT  AS TIPO_FACTURA
FROM TMP_3_NMACST_F4211_F421x
WHERE TO_CHAR(SDDOCO) = '22000054'
ORDER BY SDLNID, SDDOC;

