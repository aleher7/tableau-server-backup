WITH o AS (
  SELECT ID_ORDER, SUM(U_GROSS) UB, SUM(A_NET) IMP FROM ANL_F_SELLIN
  WHERE ID_BU='ESP' AND DATE_CONFIRMATION >= DATE '2026-01-01' AND DATE_CONFIRMATION < DATE '2026-03-01'
  GROUP BY ID_ORDER),
c AS (
  SELECT ID_ORDER, SUM(UNIDADES_BRUTAS) UB, SUM(IMPORTE_NETO) IMP
  FROM ANL_ANALISIS_CAMAPAÑAS_ESP_TMP2
  WHERE AÑO=2026 AND MES IN (1,2) AND DATA_SOURCE=1 GROUP BY ID_ORDER),
dif AS (
  SELECT NVL(o.ID_ORDER,c.ID_ORDER) ID_ORDER FROM o FULL OUTER JOIN c ON o.ID_ORDER=c.ID_ORDER
  WHERE NVL(o.UB,0)<>NVL(c.UB,0) OR NVL(o.IMP,0)<>NVL(c.IMP,0)),
dup AS (
  SELECT DISTINCT F.ID_ORDER FROM ANL_F_SELLIN F
  JOIN (SELECT ID_CAMP, ID_DELEGADO_JDE FROM ANL_M_ESP_OBJ_CAMP_DEL
        GROUP BY ID_CAMP, ID_DELEGADO_JDE HAVING COUNT(*)>1) D
    ON F.ID_CAMPAIGN=D.ID_CAMP AND F.ID_AGENT=D.ID_DELEGADO_JDE
  WHERE F.ID_BU='ESP' AND F.DATE_CONFIRMATION >= DATE '2026-01-01' AND F.DATE_CONFIRMATION < DATE '2026-03-01')
SELECT (SELECT COUNT(*) FROM dif) AS PEDIDOS_CON_DIF,
       (SELECT COUNT(*) FROM dup) AS PEDIDOS_EN_PARES_DUP,
       (SELECT COUNT(*) FROM dif WHERE ID_ORDER IN (SELECT ID_ORDER FROM dup)) AS EN_AMBOS,
       (SELECT COUNT(*) FROM dif WHERE ID_ORDER NOT IN (SELECT ID_ORDER FROM dup)) AS DIF_SIN_PAR_DUP
FROM dual;
