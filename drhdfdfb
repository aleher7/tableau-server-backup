SELECT 'REAL' tabla, COUNT(*) filas, SUM(CANTIDAD_STOCK) stock, SUM(COSTE_STOCK) coste,
       SUM(UNIDADES_BRUTAS) uds_brutas, SUM(UNIDADES_NETAS) uds_netas, SUM(TOTAL_NETO) neto
FROM   ANL_CDM_INVENTARIO
UNION ALL
SELECT 'TEST', COUNT(*), SUM(CANTIDAD_STOCK), SUM(COSTE_STOCK),
       SUM(UNIDADES_BRUTAS), SUM(UNIDADES_NETAS), SUM(TOTAL_NETO)
FROM   ANL_CDM_INVENTARIO_TEST;



SELECT NVL(a.ANIO,d.ANIO) anio, NVL(a.MES,d.MES) mes, NVL(a.BUSINESS_UNIT,d.BUSINESS_UNIT) bu, NVL(a.FLAG,d.FLAG) flag,
       a.filas real_filas, d.filas test_filas, a.stock real_stock, d.stock test_stock, a.neto real_neto, d.neto test_neto
FROM  (SELECT ANIO, MES, BUSINESS_UNIT, FLAG, COUNT(*) filas, SUM(CANTIDAD_STOCK) stock, SUM(COSTE_STOCK) coste,
              SUM(UNIDADES_BRUTAS) brutas, SUM(UNIDADES_NETAS) netas, SUM(TOTAL_NETO) neto
       FROM ANL_CDM_INVENTARIO GROUP BY ANIO, MES, BUSINESS_UNIT, FLAG) a
FULL JOIN
      (SELECT ANIO, MES, BUSINESS_UNIT, FLAG, COUNT(*) filas, SUM(CANTIDAD_STOCK) stock, SUM(COSTE_STOCK) coste,
              SUM(UNIDADES_BRUTAS) brutas, SUM(UNIDADES_NETAS) netas, SUM(TOTAL_NETO) neto
       FROM ANL_CDM_INVENTARIO_TEST GROUP BY ANIO, MES, BUSINESS_UNIT, FLAG) d
  ON  a.ANIO = d.ANIO AND a.MES = d.MES AND a.FLAG = d.FLAG
  AND DECODE(a.BUSINESS_UNIT, d.BUSINESS_UNIT, 1, 0) = 1
WHERE a.ANIO IS NULL OR d.ANIO IS NULL
   OR DECODE(a.filas,  d.filas,  0, 1) = 1
   OR DECODE(a.stock,  d.stock,  0, 1) = 1
   OR DECODE(a.coste,  d.coste,  0, 1) = 1
   OR DECODE(a.brutas, d.brutas, 0, 1) = 1
   OR DECODE(a.netas,  d.netas,  0, 1) = 1
   OR DECODE(a.neto,   d.neto,   0, 1) = 1;





SELECT t.CODIGO_CORTO, t.LOCAL_PRODUCT_CODE,
       t.CICLO_VIDA_CORP, p.CICLO_VIDA_CORP pivot_corp,
       t.CICLO_VIDA_NAC,  p.CICLO_VIDA_NAC  pivot_nac,
       t.CICLO_VIDA_INT,  p.CICLO_VIDA_INT  pivot_int
FROM   ANL_CDM_INVENTARIO_TEST t
LEFT JOIN CLABS_STG_PRO.STG_JDE_IFCSA_F55CVMAE_PIVOT p
       ON TRIM(TO_CHAR(p.COD_CORTO_PROD)) = TRIM(TO_CHAR(t.CODIGO_CORTO))
      AND TRIM(TO_CHAR(p.COD_LARGO_PROD)) = TRIM(TO_CHAR(t.LOCAL_PRODUCT_CODE))
WHERE  DECODE(t.CICLO_VIDA_CORP, p.CICLO_VIDA_CORP, 0, 1) = 1
   OR  DECODE(t.CICLO_VIDA_NAC,  p.CICLO_VIDA_NAC,  0, 1) = 1
   OR  DECODE(t.CICLO_VIDA_INT,  p.CICLO_VIDA_INT,  0, 1) = 1;






SELECT CODIGO_CORTO,
       COUNT(DISTINCT CICLO_VIDA_CORP) corp,
       COUNT(DISTINCT CICLO_VIDA_NAC)  nac,
       COUNT(DISTINCT CICLO_VIDA_INT)  int
FROM   ANL_CDM_INVENTARIO_TEST
GROUP  BY CODIGO_CORTO
HAVING COUNT(DISTINCT CICLO_VIDA_CORP) > 1
    OR COUNT(DISTINCT CICLO_VIDA_NAC)  > 1
    OR COUNT(DISTINCT CICLO_VIDA_INT)  > 1;






SELECT BUSINESS_UNIT, FLAG,
       COUNT(*)               filas,
       COUNT(CICLO_VIDA_CORP) con_corp,
       COUNT(CICLO_VIDA_NAC)  con_nac,
       COUNT(CICLO_VIDA_INT)  con_int
FROM   ANL_CDM_INVENTARIO_TEST
GROUP  BY BUSINESS_UNIT, FLAG
ORDER  BY 1, 2;
