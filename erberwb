WITH COD_BASE AS (
  SELECT DISTINCT TRIM(IMLITM) AS COD_BASE, TRIM(IMPRP1) AS TIPO_BASE
  FROM CLABS_STG_PRO.STG_JDE_IFCSA_F4101_ADT
),
PROD AS (
  SELECT DISTINCT COD_LARGO_PROD
  FROM ANL_IND_UNIDADES_FABRICADAS
  WHERE ALMACEN = 'CL1T' AND TIPO_PRODUCTO = 'PR'
    AND FECHA_FINALIZACION > 20260000
    AND CLASIFICACION_FABRICA = 'UDS MUESTRA ACONDICIONADO'
)
SELECT DISTINCT
       P.COD_LARGO_PROD AS PRODUCTO_CL1T,
       F.COD_LARGO_PROD AS CODIGO_EN_CL1,
       F.TIPO_PRODUCTO,
       CASE WHEN REGEXP_LIKE(F.COD_LARGO_PROD, '-00(2|9)$*') THEN 'SI' ELSE 'NO' END AS SUFIJO_002_009,
       CB.TIPO_BASE
FROM PROD P
JOIN ANL_IND_UNIDADES_FABRICADAS F
       ON F.ALMACEN = 'CL1'
      AND F.COD_LARGO_PROD LIKE TRIM(P.COD_LARGO_PROD) || '%'
LEFT JOIN COD_BASE CB
       ON CB.COD_BASE = REGEXP_REPLACE(REGEXP_REPLACE(F.COD_LARGO_PROD,'-00[0-9]$',''),'-00[0-9]...$','')
ORDER BY 1, 2;
