SELECT TO_CHAR(TO_DATE(TO_CHAR(1900000 + SDADDJ), 'YYYYDDD'), 'YYYY-MM') mes,
       COUNT(*) filas, COUNT(DISTINCT SDDOCO) pedidos
FROM TMP_3_NMACST_F4211_F421x
WHERE SDADDJ >= 126000
GROUP BY TO_CHAR(TO_DATE(TO_CHAR(1900000 + SDADDJ), 'YYYYDDD'), 'YYYY-MM')
ORDER BY 1;


SELECT 1900 + TRUNC(t.f/1000) anio, COUNT(*) pedidos_con_repetidos
FROM (SELECT DISTINCT PEDIDO FROM STD_NM_PEDIDOS
      WHERE (SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID) IN
        (SELECT SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID FROM STD_NM_PEDIDOS
         GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID HAVING COUNT(*) > 1)) d
JOIN (SELECT SDDOCO, MAX(SDADDJ) f FROM TMP_3_NMACST_F4211_F421x GROUP BY SDDOCO) t
  ON TO_CHAR(t.SDDOCO) = TO_CHAR(d.PEDIDO)
GROUP BY 1900 + TRUNC(t.f/1000)
ORDER BY 1;
