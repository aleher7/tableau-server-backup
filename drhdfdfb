SELECT DISTINCT i.BUSINESS_UNIT, i.CODIGO_CORTO,
       i.LOCAL_PRODUCT_NAME nombre_bu_dudosa,
       o.BUSINESS_UNIT      otra_bu,
       o.LOCAL_PRODUCT_NAME nombre_otra_bu
FROM   ANL_CDM_INVENTARIO i
JOIN   CLABS_STG_PRO.STG_JDE_IFCSA_F55CVMAE_PIVOT p
       ON TRIM(TO_CHAR(p.COD_CORTO_PROD)) = TRIM(TO_CHAR(i.CODIGO_CORTO))
LEFT JOIN ANL_CDM_INVENTARIO o
       ON o.CODIGO_CORTO = i.CODIGO_CORTO
      AND o.BUSINESS_UNIT NOT IN ('CLABS MEXICO','CLABS PORTUGAL')
WHERE  i.BUSINESS_UNIT IN ('CLABS MEXICO','CLABS PORTUGAL')
  AND  NOT EXISTS (SELECT 1 FROM ANL_CDM_INVENTARIO e
                   WHERE e.CODIGO_CORTO = i.CODIGO_CORTO
                     AND e.BUSINESS_UNIT IN ('CLABS SPAIN','INDUSTRIAL'))
ORDER BY 1, 2;
