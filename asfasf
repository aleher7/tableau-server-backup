SELECT SDDCTO, COUNT(*) AS ajustes_stadpp
FROM TMP_4_NDL_PED_CAMPOS
WHERE SDKCOO = '00400'
  AND TRIM(TIPO_DESC) LIKE 'STADPP%'
GROUP BY SDDCTO;



SELECT SUM(DCTO_PRONTO_PAGO) FROM STD_NDL_PEDIDOS_NORM;



SELECT COUNT(DISTINCT SDDOCO || '-' || SDDCTO || '-' || SDLNID) AS lineas_sin_tarifa
FROM TMP_4_NDL_PED_CAMPOS
WHERE IMP_BRU IS NULL;



SELECT SUBSTR(NUM_PEDIDO,-2) AS tipo, COUNT(*) AS filas,
       SUM(CASE WHEN IMPORTE_BRUTO = 0 THEN 1 ELSE 0 END) AS bruto_cero,
       SUM(CASE WHEN IMPORTE_BRUTO IS NULL THEN 1 ELSE 0 END) AS bruto_nulo
FROM STD_NDL_PEDIDOS_NORM
GROUP BY SUBSTR(NUM_PEDIDO,-2);



SELECT SUBSTR(NUM_PEDIDO,-2) AS tipo,
       COUNT(*) AS filas,
       SUM(CASE WHEN UNIDADES_NETAS = 0 AND PRECIO_NETO <> 0 THEN 1 ELSE 0 END) AS precio_con_unidades_cero,
       SUM(CASE WHEN UNIDADES_NETAS <> 0 AND ABS(PRECIO_NETO - IMPORTE_NETO/UNIDADES_NETAS) > 0.01 THEN 1 ELSE 0 END) AS precio_incoherente
FROM STD_NDL_PEDIDOS_NORM
GROUP BY SUBSTR(NUM_PEDIDO,-2);
