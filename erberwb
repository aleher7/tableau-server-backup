WITH COD_BASE AS (
  SELECT DISTINCT TRIM(IMLITM) AS COD_BASE, TRIM(IMPRP1) AS TIPO_BASE
  FROM CLABS_STG_PRO.STG_JDE_IFCSA_F4101_ADT
),
COD_CL1 AS (
  SELECT DISTINCT F.COD_LARGO_PROD
  FROM ANL_IND_UNIDADES_FABRICADAS F
  LEFT JOIN COD_BASE CB
         ON CB.COD_BASE = REGEXP_REPLACE(REGEXP_REPLACE(F.COD_LARGO_PROD,'-00[0-9]$',''),'-00[0-9]...$','')
  WHERE F.ALMACEN = 'CL1'
    AND REGEXP_LIKE(F.COD_LARGO_PROD, '-00(2|9)$*')
    AND F.TIPO_PRODUCTO = 'PS'
    AND CB.TIPO_BASE IN ('PR','PT')
),
BASE AS (
  SELECT X.COD_LARGO_PROD, X.SUBTIPO_PRODUCTO, X.CLASIFICACION_FABRICA,
         CASE WHEN EXISTS (
                SELECT 1 FROM COD_CL1 C
                WHERE REGEXP_REPLACE(REGEXP_REPLACE(C.COD_LARGO_PROD,'-00[0-9]$',''),'-00[0-9]...$','') = X.COD_LARGO_PROD
              ) THEN 'CON PAREJA' ELSE 'SIN PAREJA' END AS JOIN_CL1
  FROM ANL_IND_UNIDADES_FABRICADAS X
  WHERE X.ALMACEN = 'CL1T'
    AND X.TIPO_PRODUCTO = 'PR'
    AND X.FECHA_FINALIZACION > 20260000
)
SELECT SUBTIPO_PRODUCTO,
       JOIN_CL1,
       CLASIFICACION_FABRICA AS GUARDADA,
       CASE WHEN JOIN_CL1 = 'CON PAREJA'    THEN 'UDS MUESTRA MANIPULADO'
            WHEN SUBTIPO_PRODUCTO = 'MUE'   THEN 'UDS MUESTRA ACONDICIONADO'
            ELSE NULL END AS ESPERADA,
       COUNT(*) AS FILAS,
       COUNT(DISTINCT COD_LARGO_PROD) AS PRODUCTOS
FROM BASE
GROUP BY SUBTIPO_PRODUCTO, JOIN_CL1, CLASIFICACION_FABRICA
ORDER BY 1, 2;
