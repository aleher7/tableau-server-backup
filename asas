THEN 1 ELSE 0 END) ELSE 0 END) AS MTD,
(CASE   WHEN EXTRACT(MONTH FROM SYSDATE) = 12  AND CAST(SUBSTR(FECHA,1,4) AS NUMBER)=EXTRACT(YEAR FROM SYSDATE) THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 11 AND ((CAST(SUBSTR(FECHA,1,4) AS NUMBER)=EXTRACT(YEAR FROM SYSDATE) AND CAST(SUBSTR(FECHA,5,2) AS NUMBER) BETWEEN 01 AND 11) OR (CAST(SUBSTR(FECHA,1,4) AS NUMBER)=EXTRACT(YEAR FROM SYSDATE)-1 AND CAST(SUBSTR(FECHA,5,2) AS NUMBER) IN (12))) THEN 1
