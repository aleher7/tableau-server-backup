CEN.TIPO TIPO_CENTRO,
CEN.CODIGO_JDE CODIGO_JDE_CENTRO,
CNT.NOMBRE_APELLIDO Nombre_Apellido_Contacto,
CNT.ORIENTACION_AL_DISPENSING Orientacion_al_dispensing,
CNT.VISITAS_RED_CARE Visitas_Red_Care,
CNT.VISITAS_RED_DERM Visitas_Red_Derm,
CNT.VISITAS_RED_SKIN Visitas_Red_Skin,
CNT.PERFIL_COSMETICO Perfil_Cosmetico,
CNT.POTENCIAL_DE_RECETA Potencial_de_Receta,
CNT.CATEGORIA Categoria,
CNT.CICLO_VIDA_CLIENTE Ciclo_Vida_Cliente,
CNT.CICLO_VIDA_CLIENTE_PLUS Ciclo_Vida_Cliente_Plus,
CNT.CICLO_VIDA_CLIENTE_NEO Ciclo_Vida_Cliente_Neo,
CNT.NIVEL_COMPROMISO Nivel_Compromiso,
CNT.DECIL Decil,
CNT.RESIDENCIA Residencia,
