SELECT tipo_fila, red, COUNT(*) AS filas, COUNT(DISTINCT par) AS parejas
FROM (SELECT CASE WHEN ID_VISITA IS NULL THEN 'sin visita' ELSE 'con visita' END AS tipo_fila,
             NVL(RED_NEGOCIO_VISITA, '(NULL)') AS red,
             AGENTE_WID || '-' || CONTACTO_WID AS par
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 <filtro>)
GROUP BY tipo_fila, red ORDER BY 1, 2;


SELECT NVL(RED_NEGOCIO_VISITA, '(NULL)') AS red, COUNT(*) AS parejas
FROM (SELECT DISTINCT RED_NEGOCIO_VISITA, AGENTE_WID, CONTACTO_WID
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 <filtro>)
GROUP BY NVL(RED_NEGOCIO_VISITA, '(NULL)') ORDER BY 1;


SELECT TIPO_VISITA, COUNT(DISTINCT ID_VISITA) AS visitas_totales,
       COUNT(DISTINCT VISITAS) AS visitas_contadas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026 AND ID_VISITA IS NOT NULL AND RED_NEGOCIO_VISITA = 'Red Plus' <filtro>
GROUP BY TIPO_VISITA ORDER BY 1;


SELECT nredes, COUNT(*) AS parejas
FROM (SELECT AGENTE_WID, CONTACTO_WID, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 AND RED_NEGOCIO_VISITA IS NOT NULL
        AND RED_NEGOCIO_VISITA <> 'NA' <filtro>
      GROUP BY AGENTE_WID, CONTACTO_WID)
GROUP BY nredes ORDER BY nredes;


SELECT COLUMN_NAME FROM ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'ANL_ACTIVIDAD_ESP' AND COLUMN_NAME LIKE '%FICH%';
