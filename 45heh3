SELECT COUNT(*) AS agentes_con_varias_divisiones
FROM (SELECT AGENTE_WID FROM ANL_ACTIVIDAD_ESP WHERE AÑO >= 2024
      GROUP BY AGENTE_WID HAVING COUNT(DISTINCT DIVISION) > 1);


SELECT AGENTE_WID, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes,
       COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL AND RED_NEGOCIO_VISITA IS NOT NULL
  AND RED_NEGOCIO_VISITA <> 'NA' <filtro>
GROUP BY AGENTE_WID HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) >= 3
ORDER BY 2 DESC, 3 DESC;



SELECT AÑO, MES, RED_NEGOCIO_VISITA, DIVISION,
       COUNT(DISTINCT ID_VISITA) AS visitas_totales, COUNT(DISTINCT VISITAS) AS visitas_contadas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO >= 2024 AND ID_VISITA IS NOT NULL <filtro>
GROUP BY AÑO, MES, RED_NEGOCIO_VISITA, DIVISION ORDER BY 1, 2, 3;


SELECT NVL(RED_NEGOCIO_VISITA, '(NULL)') AS red, COUNT(*) AS parejas
FROM (SELECT DISTINCT RED_NEGOCIO_VISITA, CONTACTO_WID FROM ANL_ACTIVIDAD_ESP
      WHERE AGENTE_WID = <id> AND F_FICH_AGENTE_CONTACTO = 1 AND AÑO >= 2024 <filtro>)
GROUP BY NVL(RED_NEGOCIO_VISITA, '(NULL)') ORDER BY 1;
