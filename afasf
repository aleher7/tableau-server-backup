SELECT *
FROM ANL_M_ESP_OBJ_CAMP_DEL
WHERE ID_CAMP = 'CYC125'
  AND ID_DELEGADO_JDE IN (245680, 240902, 241834)
ORDER BY ID_DELEGADO_JDE;



SELECT F.ID_ORDER,
       F.ID_AGENT,
       (SELECT COUNT(*) FROM ANL_M_ESP_OBJ_CAMP_DEL O
        WHERE O.ID_CAMP = 'CYC125'
          AND O.ID_DELEGADO_JDE = F.ID_AGENT) AS FILAS_EN_OBJETIVO,
       SUM(F.UNIDADES_BRUTAS) AS UB_ORIGEN,
       (SELECT SUM(C.UNIDADES_BRUTAS)
        FROM ANL_ANALISIS_CAMPAÑAS_ESP C
        WHERE C.DATA_SOURCE = 1
          AND C.ID_ORDER = F.ID_ORDER
          AND C.CAMPAÑA_COD = 'CYC125') AS UB_CAMPANAS
FROM ANL_F_SELLIN F
WHERE F.ID_BU = 'ESP'
  AND F.ID_CAMPAIGN = 'CYC125'
  AND F.<FECHA_CONFIRMACION> > DATE '2025-12-31'
GROUP BY F.ID_ORDER, F.ID_AGENT
ORDER BY FILAS_EN_OBJETIVO DESC, F.ID_ORDER;
