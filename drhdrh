WITH base AS (
    SELECT *
    FROM ANL_ACTIVIDAD_ESP
    WHERE (   ID_VISITA IS NULL
           OR CONTACTO_WID IS NOT NULL
           OR DIVISION IS NULL
           OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
)
SELECT RED,
       F,
       CV,
       VISITAS_FICHERO,
       ROUND(100 * CV / NULLIF(F, 0), 1)              AS COB,
       ROUND(VISITAS_FICHERO / NULLIF(CV, 0), 2)      AS FR
FROM (
    SELECT CASE WHEN GROUPING(RED_NEGOCIO_VISITA) = 1 THEN 'TOTAL'
                ELSE NVL(RED_NEGOCIO_VISITA, '(null)') END AS RED,
           COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
                               THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS F,
           COUNT(DISTINCT CASE WHEN CONTACTOS_VISITADOS_FICHERO IS NOT NULL AND AÑO = '2026'
                               THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS CV,
           COUNT(DISTINCT CASE WHEN AÑO = '2026'
                               THEN VISITAS_FICHERO END) AS VISITAS_FICHERO
    FROM base
    GROUP BY ROLLUP (RED_NEGOCIO_VISITA)
)
ORDER BY CASE WHEN RED = 'TOTAL' THEN 1 ELSE 0 END, RED;
