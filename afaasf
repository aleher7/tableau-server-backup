-- 1. Filas por año, mes y tipo en la vista (2027: solo fichero/coach, 36.917 filas y 153 agentes por mes)
SELECT AÑO, MES, CASE WHEN ID_VISITA IS NULL THEN 'fichero/coach' ELSE 'visita' END AS tipo_fila,
       COUNT(*) AS filas, COUNT(DISTINCT AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP WHERE AÑO >= 2026
GROUP BY AÑO, MES, CASE WHEN ID_VISITA IS NULL THEN 'fichero/coach' ELSE 'visita' END ORDER BY 1, 2, 3;

-- 2. El origen ya trae 2027 (meses 1-6, 8, 9 con 36.917 filas y 153 agentes)
SELECT AÑO, MES, COUNT(*) AS FILAS, COUNT(DISTINCT AGENTE_WID) AS AGENTES
FROM ANL_AUX_ACT_FICHERO_ESP WHERE AÑO >= 2026 GROUP BY AÑO, MES ORDER BY 1, 2;

-- 3. Parejas nuevas de 2027 respecto a 2024-2026 (resultado: 0)
SELECT COUNT(*) AS PAREJAS_NUEVAS FROM (
  SELECT DISTINCT AGENTE_WID, CONTACTO_WID FROM ANL_ACTIVIDAD_ESP WHERE AÑO = 2027 AND F_FICH_AGENTE_CONTACTO = 1
  MINUS
  SELECT DISTINCT AGENTE_WID, CONTACTO_WID FROM ANL_ACTIVIDAD_ESP WHERE AÑO BETWEEN 2024 AND 2026 AND F_FICH_AGENTE_CONTACTO = 1);

-- 4. Quién escribe en la tabla auxiliar (solo el procedimiento COMPLETA_FICHERO_ACTIVIDAD, en DEV y PRO)
SELECT OWNER, NAME, TYPE, LINE, TEXT FROM ALL_SOURCE
WHERE UPPER(TEXT) LIKE '%ANL_AUX_ACT_FICHERO_ESP%' ORDER BY OWNER, NAME, LINE;

-- 5. Por qué existen esos meses: visitas planificadas en el origen (2027-02 a 2027-09 solo «Planificada»)
SELECT SUBSTR(FECHA_VISITA,1,6) AS aniomes, ESTADO_VISITA, COUNT(*) AS filas
FROM ANL_F_IFC_ACTIVIDAD WHERE SUBSTR(FECHA_VISITA,1,6) >= '202611'
GROUP BY SUBSTR(FECHA_VISITA,1,6), ESTADO_VISITA ORDER BY 1, 2;

-- 6. «Terminado» solo en actividades; «Terminada» solo en visitas
SELECT ESTADO_VISITA, TIPO_VISITA, COUNT(*) AS filas
FROM ANL_F_IFC_ACTIVIDAD WHERE SUBSTR(FECHA_VISITA,1,4) >= '2024'
GROUP BY ESTADO_VISITA, TIPO_VISITA ORDER BY 1, 2;


-- 7. Visitas por división, con y sin el filtro actual (la suma de la diferencia da 501; con filtro = 141.408)
SELECT DIVISION,
       COUNT(DISTINCT VISITAS) AS v_sin_filtro,
       COUNT(DISTINCT CASE WHEN (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
                                 OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
                           THEN VISITAS END) AS v_con_filtro
FROM ANL_ACTIVIDAD_ESP WHERE AÑO = 2026 AND ID_VISITA IS NOT NULL
GROUP BY DIVISION ORDER BY 1;

-- 8. Qué hay en las filas sin contacto, por división
SELECT DIVISION, COUNT(*) AS filas, COUNT(VISITAS) AS con_visita_contada, COUNT(IMPACTOS) AS con_impactos,
       COUNT(DISTINCT IMPACTOS) AS impactos, COUNT(ACTIVIDAD) AS con_actividad
FROM ANL_ACTIVIDAD_ESP WHERE AÑO = 2026 AND ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL
GROUP BY DIVISION ORDER BY 1;
