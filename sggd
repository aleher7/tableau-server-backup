SELECT RED_NEGOCIO_VISITA,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS F,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END)
     - COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND ZONA IS NOT NULL
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS PIERDE_ZONA,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END)
     - COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND GERENTE IS NOT NULL
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS PIERDE_GERENTE,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END)
     - COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND TIPO IS NOT NULL
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS PIERDE_TIPO,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END)
     - COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND SUBTIPO IS NOT NULL
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS PIERDE_SUBTIPO
FROM ANL_ACTIVIDAD_ESP
WHERE (   ID_VISITA IS NULL
       OR CONTACTO_WID IS NOT NULL
       OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY RED_NEGOCIO_VISITA
ORDER BY 1;
