SELECT AÑO, DIVISION,
       COUNT(*) FILAS_VISITA,
       SUM(CASE WHEN CONTACTO_WID IS NULL THEN 1 ELSE 0 END) FILAS_SIN_CONTACTO,
       COUNT(DISTINCT CASE WHEN CONTACTO_WID IS NULL THEN ID_VISITA END) VISITAS_SIN_CONTACTO
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO BETWEEN 2024 AND 2026
  AND ID_VISITA IS NOT NULL
GROUP BY AÑO, DIVISION
ORDER BY DIVISION, AÑO;



SELECT DIVISION, ORIGEN_TIPO_SF, TIPO_VISITA, ESTADO_VISITA, SN_ONLINE,
       COUNT(*) FILAS, COUNT(DISTINCT ID_VISITA) IDS, COUNT(VISITAS) CON_VISITA_CONTADA
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND ID_VISITA IS NOT NULL
  AND CONTACTO_WID IS NULL
  AND DIVISION IN ('SELECT','REMOTE')
GROUP BY DIVISION, ORIGEN_TIPO_SF, TIPO_VISITA, ESTADO_VISITA, SN_ONLINE
ORDER BY DIVISION, FILAS DESC;



SELECT DIVISION, ORIGEN_TIPO_SF, TIPO_VISITA, ESTADO_VISITA, SN_ONLINE,
       COUNT(*) FILAS, COUNT(DISTINCT ID_VISITA) IDS, COUNT(VISITAS) CON_VISITA_CONTADA
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND ID_VISITA IS NOT NULL
  AND CONTACTO_WID IS NULL
  AND DIVISION IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')
GROUP BY DIVISION, ORIGEN_TIPO_SF, TIPO_VISITA, ESTADO_VISITA, SN_ONLINE
ORDER BY DIVISION, FILAS DESC;
