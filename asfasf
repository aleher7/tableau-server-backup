UNION ALL SELECT 'TMP_4', COUNT(*), COUNT(DISTINCT SDKCOO||'-'||SDDCTO||'-'||SDLNID)
  FROM TMP_4_NM_PEDIDOS WHERE TO_CHAR(SDDOCO) = '22000054'
UNION ALL SELECT 'TMP_5', COUNT(*), COUNT(DISTINCT SDKCOO||'-'||SDDCTO||'-'||SDLNID)
  FROM TMP_5_NM_PED_CAMPOS WHERE TO_CHAR(SDDOCO) = '22000054'
UNION ALL SELECT 'TMP_6', COUNT(*), COUNT(DISTINCT SDKCOO||'-'||SDDCTO||'-'||SDLNID)
  FROM TMP_6_NM_PED_CAMPOS2 WHERE TO_CHAR(SDDOCO) = '22000054'
UNION ALL SELECT 'FINAL', COUNT(*), COUNT(DISTINCT SDKCOO||'-'||TIPO_PEDIDO||'-'||SDLNID)
