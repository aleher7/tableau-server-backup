WITH base AS (
    SELECT a.*
    FROM ANL_ACTIVIDAD_ESP a
    WHERE AÑO >= '2024'
      AND (   ID_VISITA IS NULL
           OR CONTACTO_WID IS NOT NULL
           OR DIVISION IS NULL
           OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
)
SELECT 'DIVISION' AS campo,
       CASE WHEN GROUPING(DIVISION) = 1 THEN 'TOTAL' ELSE NVL(TO_CHAR(DIVISION), '(null)') END AS valor,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
                           THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS f
FROM base GROUP BY ROLLUP (DIVISION)
UNION ALL
SELECT 'RED_NEGOCIO_VISITA',
       CASE WHEN GROUPING(RED_NEGOCIO_VISITA) = 1 THEN 'TOTAL' ELSE NVL(TO_CHAR(RED_NEGOCIO_VISITA), '(null)') END,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
                           THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END)
FROM base GROUP BY ROLLUP (RED_NEGOCIO_VISITA)
ORDER BY 1, 2;
