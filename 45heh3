SELECT SUM(nredes - 1) AS dias_extra
FROM (SELECT AGENTE_WID, AÑO, MES, DIA, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO = 2026 AND VISITAS IS NOT NULL <filtro>
      GROUP BY AGENTE_WID, AÑO, MES, DIA
      HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1);


SELECT COUNT(*) AS filas_distintas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND ((VISITAS_FICHERO IS NOT NULL AND F_FICH_AGENTE_CONTACTO <> 1)
    OR (VISITAS_FICHERO IS NULL AND VISITAS IS NOT NULL AND F_FICH_AGENTE_CONTACTO = 1));


SELECT RED_NEGOCIO_VISITA, TIPO_VISITA,
       CASE WHEN PRODUCTO_REPORTE_WID > 0 THEN 'con producto'
            WHEN PRODUCTO_REPORTE_WID = -1 THEN 'sin producto' ELSE 'otro' END AS producto,
       COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO = 2025 AND MES BETWEEN 2 AND 7 AND ID_VISITA IS NOT NULL <filtro>
GROUP BY RED_NEGOCIO_VISITA, TIPO_VISITA,
         CASE WHEN PRODUCTO_REPORTE_WID > 0 THEN 'con producto'
              WHEN PRODUCTO_REPORTE_WID = -1 THEN 'sin producto' ELSE 'otro' END
ORDER BY 1, 2, 3;
