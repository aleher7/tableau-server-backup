SELECT AÑO, MES, ROUND(SUM(DESCUENTO_PENDIENTE),2) FROM TMP_SUPPLY_NEW
WHERE DATA_SOURCE=1 GROUP BY AÑO, MES
MINUS
SELECT AÑO, MES, ROUND(SUM(DESCUENTO_PENDIENTE),2) FROM "ANL_ANALISIS_CAMPAÑAS_ESP"
WHERE DATA_SOURCE=1 AND AGRUPACION_TIPO_PEDIDO='1.- PREVENTA'
  AND AÑO >= (SELECT MAX(AÑO)-1 FROM "ANL_ANALISIS_CAMPAÑAS_ESP"
              WHERE DATA_SOURCE=1 AND AGRUPACION_TIPO_PEDIDO='1.- PREVENTA')
GROUP BY AÑO, MES;
-- y el inverso, cambiando el orden de las dos consultas



SELECT Cod_Producto, ROUND(SUM(DESCUENTO_PENDIENTE),2) FROM TMP_SUPPLY_NEW
WHERE DATA_SOURCE=1 GROUP BY Cod_Producto
MINUS
SELECT NOMBRE_PRODUCTO_COD, ROUND(SUM(DESCUENTO_PENDIENTE),2) FROM "ANL_ANALISIS_CAMPAÑAS_ESP"
WHERE DATA_SOURCE=1 AND AGRUPACION_TIPO_PEDIDO='1.- PREVENTA'
  AND AÑO >= (SELECT MAX(AÑO)-1 FROM "ANL_ANALISIS_CAMPAÑAS_ESP"
              WHERE DATA_SOURCE=1 AND AGRUPACION_TIPO_PEDIDO='1.- PREVENTA')
GROUP BY NOMBRE_PRODUCTO_COD;


SELECT COUNT(*) FROM (
  SELECT año, MES, IS_PACK, ITM_PACK, Cod_Producto, cliente_entrega_cod, NOMBRE_CLIENTE_AGRUPADO_COD,
         COUNT(*) C
  FROM TMP_SUPPLY_NEW WHERE DATA_SOURCE=1
  GROUP BY año, MES, IS_PACK, ITM_PACK, Cod_Producto, cliente_entrega_cod, NOMBRE_CLIENTE_AGRUPADO_COD
  HAVING COUNT(*)>1);


  SELECT AÑO, SUM(UNIDADES_BRUTAS), SUM(IMPORTE_NETO), SUM(IMPORTE_PENDIENTE_SERVIR), SUM(IMPORTE_BACKORDER)
FROM ANL_ESP_SUPPLY_PREVENTAS WHERE DATA_SOURCE=1 GROUP BY AÑO
MINUS
SELECT AÑO, SUM(UNIDADES_BRUTAS), SUM(IMPORTE_NETO), SUM(IMPORTE_PENDIENTE_SERVIR), SUM(IMPORTE_BACKORDER)
FROM TMP_SUPPLY_NEW WHERE DATA_SOURCE=1 GROUP BY AÑO;


SELECT MIN(DESCUENTO_PENDIENTE), MAX(DESCUENTO_PENDIENTE),
       SUM(CASE WHEN DESCUENTO_PENDIENTE<0 THEN 1 END) AS NEGATIVOS,
       COUNT(CASE WHEN DESCUENTO_PENDIENTE<>0 THEN 1 END) AS FILAS_CON_VALOR
FROM TMP_SUPPLY_NEW WHERE DATA_SOURCE=1;


SELECT COUNT(*) FROM TMP_SUPPLY_NEW
WHERE DATA_SOURCE=1 AND NVL(IMPORTE_PENDIENTE_SERVIR,0)<>0 AND NVL(DESCUENTO_PENDIENTE,0)=0;


