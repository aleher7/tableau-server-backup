WITH sin_red AS (
    SELECT DISTINCT
           ID_VISITA,
           CASE WHEN RED_NEGOCIO_VISITA = 'NA' THEN 'NA - No informado'
                ELSE 'NULL - sin contacto' END AS GRUPO
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND ID_VISITA IS NOT NULL
      AND (RED_NEGOCIO_VISITA IS NULL OR RED_NEGOCIO_VISITA = 'NA')
),
con_red AS (
    SELECT DISTINCT ID_VISITA
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND ID_VISITA IS NOT NULL
      AND RED_NEGOCIO_VISITA IS NOT NULL
      AND RED_NEGOCIO_VISITA <> 'NA'
)
SELECT s.GRUPO,
       COUNT(*)            AS VISITAS_DISTINTAS,
       COUNT(c.ID_VISITA)  AS YA_CONTADAS_CON_RED,
       COUNT(*) - COUNT(c.ID_VISITA) AS SOLO_SIN_RED
FROM sin_red s
LEFT JOIN con_red c ON c.ID_VISITA = s.ID_VISITA
GROUP BY s.GRUPO;
