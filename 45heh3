SELECT COUNT(*) AS visitas_con_2_redes
FROM (SELECT ID_VISITA FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL
      GROUP BY ID_VISITA HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1);


SELECT COUNT(*) AS productos, SUM(CASE WHEN nredes > 1 THEN 1 ELSE 0 END) AS en_2_o_mas_redes
FROM (SELECT PRODUCTO_REPORTE, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AGENTE_WID = <id> AND ID_VISITA IS NOT NULL AND IMPACTOS IS NOT NULL
        AND RED_NEGOCIO_VISITA <> 'NA' <filtro>
      GROUP BY PRODUCTO_REPORTE);


SELECT RED_NEGOCIO_VISITA,
       COUNT(DISTINCT CASE WHEN ACTIVIDAD IS NOT NULL THEN ID_VISITA END) AS actividades,
       COUNT(DISTINCT CASE WHEN ACTIVIDAD IS NULL THEN ID_VISITA END) AS no_actividad
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL
GROUP BY RED_NEGOCIO_VISITA ORDER BY 1;
