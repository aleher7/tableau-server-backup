SELECT SDKCOO AS COMPANIA,
       SDDOCO AS PEDIDO,
       SDDCTO AS TIPO_PEDIDO,
       SDLNID AS LINEA,
       SDITM  AS ARTICULO,
       SDDOC  AS FACTURA,
       SDDCT  AS TIPO_FACTURA,
       SDADDJ AS FECHA_ENVIO_JUL,
       SDIVD  AS FECHA_FACTURA_JUL
FROM TMP_3_NMACST_F4211_F421x
WHERE TO_CHAR(SDDOCO) = '22000054'
ORDER BY SDLNID, SDDOC;

-------------------------------


SELECT 1900 + TRUNC(SDADDJ / 1000) AS ANIO,
       SDKCOO                      AS COMPANIA,
       COUNT(*)                    AS FILAS,
       COUNT(DISTINCT SDDOCO)      AS PEDIDOS
FROM TMP_3_NMACST_F4211_F421x
WHERE SDADDJ >= 124000
GROUP BY 1900 + TRUNC(SDADDJ / 1000), SDKCOO
ORDER BY 1, 2;



