SELECT f.NUM_PEDIDO, f.ID_ITM, SUM(f.DCTO_PRONTO_PAGO) AS final_total, c.esperado
FROM (
  SELECT TO_CHAR(SDDOCO) || TO_CHAR(SDDCTO) AS NUM_PEDIDO, SDITM,
         SUM(SDSOQS/10000 * ALUPRC_DESC/10000 * (-1)) AS esperado
  FROM TMP_4_NDL_PED_CAMPOS
  WHERE SDKCOO = '00400'
    AND SDDCTO IN ('SO','SN','CC')
    AND ALUPRC_DESC IS NOT NULL
    AND TRIM(TIPO_DESC) LIKE 'STADPP%'
    AND (SDADDJ <> 0 OR (SDADDJ = 0 AND SDIVD <> 0))
  GROUP BY TO_CHAR(SDDOCO) || TO_CHAR(SDDCTO), SDITM
) c
JOIN STD_NDL_PEDIDOS_NORM f ON f.NUM_PEDIDO = c.NUM_PEDIDO AND f.ID_ITM = c.SDITM
GROUP BY f.NUM_PEDIDO, f.ID_ITM, c.esperado
HAVING ABS(SUM(f.DCTO_PRONTO_PAGO) - c.esperado) > 0.01;
