SELECT COUNT(*) AS CLAVES_CON_VARIAS_FACTURAS
FROM (
    SELECT 1 AS MARCA
    FROM STD_NM_PEDIDOS
    GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID
    HAVING COUNT(*) > 1
);



