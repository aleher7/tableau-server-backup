SELECT AÑO, MES, NVL(RED_NEGOCIO_VISITA,'(NULL)') AS red, COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY AÑO, MES, NVL(RED_NEGOCIO_VISITA,'(NULL)')
ORDER BY 1, 2, 3;


SELECT RED_NEGOCIO_VISITA, MIN(AÑO*100+MES) AS primer_mes, MAX(AÑO*100+MES) AS ultimo_mes,
       COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL
GROUP BY RED_NEGOCIO_VISITA ORDER BY 2;



SELECT NVL(RED_NEGOCIO_VISITA,'(NULL)') AS red, COUNT(*) AS parejas
FROM (SELECT DISTINCT RED_NEGOCIO_VISITA, AGENTE_WID, CONTACTO_WID
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')))
GROUP BY NVL(RED_NEGOCIO_VISITA,'(NULL)') ORDER BY 1;


SELECT DIVISION, COUNT(DISTINCT AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND F_FICH_AGENTE_CONTACTO = 1 AND RED_NEGOCIO_VISITA = 'Red Plus'
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY DIVISION ORDER BY 1;


SELECT COUNT(DISTINCT r.AGENTE_WID) AS agentes
FROM ANL_ACTIVIDAD_ESP r
WHERE r.AÑO >= 2024 AND r.RED_NEGOCIO_VISITA = 'Red Plus'
  AND (r.ID_VISITA IS NULL OR r.CONTACTO_WID IS NOT NULL OR r.DIVISION IS NULL
       OR r.DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
  AND EXISTS (
    SELECT 1 FROM ANL_ACTIVIDAD_ESP f
    WHERE f.AGENTE_WID = r.AGENTE_WID
      AND f.AÑO >= 2024 AND f.F_FICH_AGENTE_CONTACTO > 0
      AND (f.ID_VISITA IS NULL OR f.CONTACTO_WID IS NOT NULL OR f.DIVISION IS NULL
           OR f.DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      AND DECODE(f.ESTATUS_ESPECIALIDAD, r.ESTATUS_ESPECIALIDAD, 1, 0) = 1
      AND DECODE(f.ESPECIALIDAD_RESUMEN, r.ESPECIALIDAD_RESUMEN, 1, 0) = 1
      AND DECODE(f.ESPECIALIDAD_PRINCIPAL, r.ESPECIALIDAD_PRINCIPAL, 1, 0) = 1
      AND DECODE(f.TIPO, r.TIPO, 1, 0) = 1
      AND DECODE(f.SUBTIPO, r.SUBTIPO, 1, 0) = 1
      AND DECODE(f.PERFIL, r.PERFIL, 1, 0) = 1);


SELECT DIVISION, COUNT(DISTINCT ID_VISITA) AS visitas_totales,
       COUNT(DISTINCT CASE WHEN CONTACTO_WID IS NULL THEN ID_VISITA END) AS sin_contacto
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL
GROUP BY DIVISION ORDER BY 1;


SELECT nredes, COUNT(*) AS agentes
FROM (SELECT AGENTE_WID, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL AND RED_NEGOCIO_VISITA <> 'NA'
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY AGENTE_WID)
GROUP BY nredes ORDER BY 1;
