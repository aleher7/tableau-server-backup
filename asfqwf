SELECT (SELECT status FROM user_objects WHERE object_name = 'INT_UNIDADES_PROYECTADAS' AND object_type = 'PROCEDURE') estado,
       (SELECT COUNT(*) FROM user_errors WHERE name = 'INT_UNIDADES_PROYECTADAS') errores,
       (SELECT COUNT(*) FROM user_source WHERE name = 'INT_UNIDADES_PROYECTADAS' AND UPPER(text) LIKE '%''INT''%') int_fijos
FROM dual;



SELECT 'SOLO_ORIGINAL' origen, text FROM (
  SELECT text FROM bkp1027_codigo_proc WHERE name = 'INT_UNIDADES_PROYECTADAS'
  MINUS
  SELECT text FROM user_source WHERE name = 'INT_UNIDADES_PROYECTADAS' AND type = 'PROCEDURE')
UNION ALL
SELECT 'SOLO_NUEVO', text FROM (
  SELECT text FROM user_source WHERE name = 'INT_UNIDADES_PROYECTADAS' AND type = 'PROCEDURE'
  MINUS
  SELECT text FROM bkp1027_codigo_proc WHERE name = 'INT_UNIDADES_PROYECTADAS');


SELECT MIN(CASE WHEN UPPER(text) LIKE '%V_ID_BU%'      THEN line END) primera_aparicion_variable,
       MIN(CASE WHEN UPPER(text) LIKE '%CURSOR %'      THEN line END) primer_cursor,
       MIN(CASE WHEN UPPER(text) LIKE '%INTO V_ID_BU%' THEN line END) linea_select_into,
       MIN(CASE WHEN UPPER(text) LIKE '%TRUNCATE%'     THEN line END) primer_truncate
FROM user_source WHERE name = 'INT_UNIDADES_PROYECTADAS' AND type = 'PROCEDURE';



SELECT NVL(a.VUELTA, d.VUELTA) vuelta, a.filas antes, d.filas despues
FROM (SELECT VUELTA, COUNT(*) filas FROM bkp1027_proyectadas_antes GROUP BY VUELTA) a
FULL OUTER JOIN (SELECT VUELTA, COUNT(*) filas FROM ANL_INT_UNIDADES_PROYECTADAS GROUP BY VUELTA) d
  ON a.VUELTA = d.VUELTA
ORDER BY 1;

SELECT COMENTARIO FROM COMENTARIO2 WHERE UPPER(COMENTARIO) LIKE 'FIN DEL PROCESO%';
