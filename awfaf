-- Clave del lado de ventas (FLAG=9)
SELECT '[' || ANIO||MES||BUSINESS_UNIT||ALMACEN||CODIGO_CORTO || ']' clave,
       LENGTH(ANIO||MES||BUSINESS_UNIT||ALMACEN||CODIGO_CORTO) longitud
FROM ANL_CDM_INVENTARIO_TMP
WHERE FLAG = 9 AND BUSINESS_UNIT = 'CLABS SPAIN' AND TRIM(CODIGO_CORTO) = '10497' AND ANIO = 2026 AND MES = 10;

-- Clave del lado de stock (las filas FLAG=0 duplicadas)
SELECT '[' || ANIO||MES||BUSINESS_UNIT||ALMACEN||CODIGO_CORTO || ']' clave,
       LENGTH(ANIO||MES||BUSINESS_UNIT||ALMACEN||CODIGO_CORTO) longitud
FROM ANL_CDM_INVENTARIO_TMP
WHERE FLAG = 0 AND BUSINESS_UNIT = 'CLABS SPAIN' AND TRIM(CODIGO_CORTO) = '10497' AND ANIO = 2026 AND MES = 10;
