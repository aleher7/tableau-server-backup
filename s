SELECT lado,
       COUNT(*)                     AS filas,
       COUNT(DISTINCT ID_AGENTE)    AS agentes,
       MIN(FECHA_VISITA)            AS desde,
       MAX(FECHA_VISITA)            AS hasta,
       SUM(CASE WHEN FLAG_DIA = 1   THEN 1 ELSE 0 END) AS dia_1,
       SUM(CASE WHEN FLAG_DIA = 0.5 THEN 1 ELSE 0 END) AS dia_05,
       SUM(CASE WHEN FLAG_DIA_FICHERO = 1 THEN 1 ELSE 0 END) AS fich_1,
       SUM(CASE WHEN FLAG_DIA_FICH_PRIV = 1 THEN 1 ELSE 0 END) AS priv_1
FROM (
  SELECT 'SOLO_NUEVA' AS lado, x.* FROM (
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM nueva
    MINUS
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM base) x
  UNION ALL
  SELECT 'SOLO_BASE', y.* FROM (
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM base
    MINUS
    SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF,
           FLAG_DIA, FLAG_DIA_FICHERO, FLAG_DIA_FICH_PUBL, FLAG_DIA_FICH_PRIV FROM nueva) y
)
GROUP BY lado;


SELECT 'SOLO_NUEVA' AS lado, COUNT(*) AS filas FROM (
  SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF FROM nueva
  MINUS
  SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF FROM base)
UNION ALL
SELECT 'SOLO_BASE', COUNT(*) FROM (
  SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF FROM base
  MINUS
  SELECT ID_SF_VISITA, ID_AGENTE, FECHA_VISITA, ORIGEN_TIPO_SF FROM nueva);
