SELECT N.CLIENTES_SIN_FICHA,
       A.CLIENTES_SIN_FICHA_ANTES
FROM (
    SELECT COUNT(DISTINCT P.SDAN8) AS CLIENTES_SIN_FICHA
    FROM STD_NM_PEDIDOS P
    LEFT JOIN STD_NMACST_CLIENTES C
           ON TO_CHAR(C.ABAN8) = TO_CHAR(P.SDAN8)
    WHERE C.ABAN8 IS NULL
) N
CROSS JOIN (
    SELECT COUNT(DISTINCT P.SDAN8) AS CLIENTES_SIN_FICHA_ANTES
    FROM STD_NM_PEDIDOS P
    LEFT JOIN STD_NMACST_CLIENTES_BKP_261015 C
           ON TO_CHAR(C.ABAN8) = TO_CHAR(P.SDAN8)
    WHERE C.ABAN8 IS NULL
) A;
