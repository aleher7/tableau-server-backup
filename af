WITH parejas AS (
  SELECT DISTINCT ID_CONTACTO_SF, ID_AGENTE
  FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE  ORIGEN_TIPO_SF = 'Fichero'
  AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
),
obj AS (
  SELECT ID_CONTACTO_SF, ID_AGENTE, SUM(OBJ_MES) AS OBJETIVO
  FROM  (SELECT ID_CONTACTO_SF, ID_AGENTE, MONTH, MAX(OBJETIVO_MED) AS OBJ_MES
         FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
         WHERE  ORIGEN_TIPO_SF = 'Fichero'
         AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
         AND    TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
         GROUP  BY ID_CONTACTO_SF, ID_AGENTE, MONTH)
  GROUP BY ID_CONTACTO_SF, ID_AGENTE
),
vis AS (
  SELECT ID_CONTACTO_SF, ID_AGENTE, COUNT(DISTINCT ID_SF_VISITA) AS VISITAS
  FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE  ORIGEN_TIPO_SF = 'Visita'
  AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
  AND    FICHERO_FLAG = '1'
  AND    ESTADO_VISITA = 'TERMINADA'
  AND    TIPO_VISITA IN ('VISITA', 'VISITA REMOTA')
  AND    TO_NUMBER(YEAR)  = EXTRACT(YEAR  FROM SYSDATE - 1)
  AND    TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
  GROUP  BY ID_CONTACTO_SF, ID_AGENTE
)
SELECT p.ID_AGENTE, p.ID_CONTACTO_SF,
       NVL(v.VISITAS, 0)         AS VISITAS,
       o.OBJETIVO                AS OBJETIVO_EXACTO,
       TRUNC(NVL(o.OBJETIVO, 0)) AS OBJETIVO_TABLEAU
FROM   parejas p
LEFT JOIN obj o ON o.ID_CONTACTO_SF = p.ID_CONTACTO_SF AND o.ID_AGENTE = p.ID_AGENTE
LEFT JOIN vis v ON v.ID_CONTACTO_SF = p.ID_CONTACTO_SF AND v.ID_AGENTE = p.ID_AGENTE
WHERE  NVL(v.VISITAS, 0) >= TRUNC(NVL(o.OBJETIVO, 0))
AND    NVL(v.VISITAS, 0) <  NVL(o.OBJETIVO, 0);
