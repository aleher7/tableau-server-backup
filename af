WITH obj AS (
  SELECT ID_CONTACTO_SF, ID_AGENTE, TO_NUMBER(MONTH) AS MES, MAX(OBJETIVO_MED) AS OBJ
  FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE  ORIGEN_TIPO_SF = 'Fichero'
  AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
  AND    TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
  GROUP  BY ID_CONTACTO_SF, ID_AGENTE, TO_NUMBER(MONTH)
),
vis AS (
  SELECT ID_CONTACTO_SF, ID_AGENTE, TO_NUMBER(MONTH) AS MES, COUNT(DISTINCT ID_SF_VISITA) AS VISITAS
  FROM   CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
  WHERE  ORIGEN_TIPO_SF = 'Visita'
  AND    UPPER(TIPO_RED) LIKE '%MEDICA%'
  AND    FICHERO_FLAG = '1' AND ESTADO_VISITA = 'TERMINADA'
  AND    TIPO_VISITA IN ('VISITA', 'VISITA REMOTA')
  AND    TO_NUMBER(YEAR) = EXTRACT(YEAR FROM SYSDATE - 1)
  AND    TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
  GROUP  BY ID_CONTACTO_SF, ID_AGENTE, TO_NUMBER(MONTH)
)
SELECT CASE WHEN TRUNC(NVL(o.OBJ, 0)) = 0 THEN 'Sem objetivo'
            WHEN NVL(v.VISITAS, 0) >= TRUNC(o.OBJ) THEN 'Objetivo Alcançado'
            ELSE 'Objetivo não Alcançado' END AS ESTADO,
       COUNT(*) AS CELDAS
FROM   obj o
LEFT JOIN vis v ON v.ID_CONTACTO_SF = o.ID_CONTACTO_SF
               AND v.ID_AGENTE = o.ID_AGENTE AND v.MES = o.MES
GROUP  BY CASE WHEN TRUNC(NVL(o.OBJ, 0)) = 0 THEN 'Sem objetivo'
               WHEN NVL(v.VISITAS, 0) >= TRUNC(o.OBJ) THEN 'Objetivo Alcançado'
               ELSE 'Objetivo não Alcançado' END;
