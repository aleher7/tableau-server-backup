SELECT 'VISTA' AS ORIGEN, SUM(a.UNIDADES_BRUTAS) AS TOTAL
FROM anl_venta_interna_esp a
JOIN CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW v ON a.PRODUCTO_AGRUPADO_COD = v.LOCAL_PRODUCT_CODE
WHERE a.data_source = 1
UNION ALL
SELECT 'JOIN', SUM(a.UNIDADES_BRUTAS)
FROM anl_venta_interna_esp a
JOIN anl_m_prod_catalog_local l ON a.PRODUCTO_AGRUPADO_COD = l.LOCAL_PRODUCT_CODE
JOIN anl_m_prod_catalog_corp c ON l.grouped_gold_code = c.grouped_gold_code
WHERE a.data_source = 1;
