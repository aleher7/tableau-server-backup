SELECT COUNT(*) AS maestro
  FROM clabs_anl_pro.anl_m_ifc_agentes
 WHERE id_sf_user IS NOT NULL;

SELECT COUNT(*)                                            AS total_hist,
       SUM(CASE WHEN flag_activo = 1 THEN 1 ELSE 0 END)    AS activos,
       SUM(CASE WHEN flag_activo = 0 THEN 1 ELSE 0 END)    AS cerrados,
       SUM(CASE WHEN id_sf_user IS NULL THEN 1 ELSE 0 END) AS id_nulos,
       SUM(CASE WHEN fecha_fin IS NULL
                  OR fecha_fin <> TO_DATE('31-12-9999','DD-MM-YYYY') THEN 1 ELSE 0 END) AS fecha_fin_rara,
       SUM(CASE WHEN fecha_inicio <> TO_DATE('01-01-1900','DD-MM-YYYY') THEN 1 ELSE 0 END) AS fecha_ini_rara
  FROM clabs_anl_pro.anl_m_ifc_agentes_hist;



SELECT COUNT(*) AS maestro
  FROM clabs_anl_pro.anl_m_ifc_centros
 WHERE id_sf IS NOT NULL;

SELECT COUNT(*)                                         AS total_hist,
       SUM(CASE WHEN flag_activo = 1 THEN 1 ELSE 0 END) AS activos,
       SUM(CASE WHEN flag_activo = 0 THEN 1 ELSE 0 END) AS cerrados,
       SUM(CASE WHEN id_sf IS NULL THEN 1 ELSE 0 END)   AS id_nulos,
       SUM(CASE WHEN fecha_fin IS NULL
                  OR fecha_fin <> TO_DATE('31-12-9999','DD-MM-YYYY') THEN 1 ELSE 0 END) AS fecha_fin_rara,
       SUM(CASE WHEN fecha_inicio <> TO_DATE('01-01-1900','DD-MM-YYYY') THEN 1 ELSE 0 END) AS fecha_ini_rara
  FROM clabs_anl_pro.anl_m_ifc_centros_hist;
