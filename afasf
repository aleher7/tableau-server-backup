SELECT DISTINCT F.ID_ORDER, F.ID_CAMPAIGN, F.ID_AGENT
FROM ANL_F_SELLIN F
JOIN (SELECT ID_CAMP, ID_DELEGADO_JDE FROM ANL_M_ESP_OBJ_CAMP_DEL
      GROUP BY ID_CAMP, ID_DELEGADO_JDE HAVING COUNT(*)>1) D
  ON F.ID_CAMPAIGN=D.ID_CAMP AND F.ID_AGENT=D.ID_DELEGADO_JDE
WHERE F.ID_BU='ESP'
  AND F.DATE_CONFIRMATION >= DATE '2026-01-01' AND F.DATE_CONFIRMATION < DATE '2026-03-01'
ORDER BY 1;



SELECT COUNT(*) FROM ANL_F_SELLIN F WHERE F.ID_BU='ESP' AND F.ID_ORDER='<pedido>';

SELECT COUNT(*) FROM ANL_F_SELLIN F
LEFT JOIN ANL_M_ESP_OBJ_CAMP_DEL OBJ
  ON F.ID_CAMPAIGN=OBJ.ID_CAMP AND F.ID_AGENT=OBJ.ID_DELEGADO_JDE
WHERE F.ID_BU='ESP' AND F.ID_ORDER='<pedido>';
