SELECT CATEGORIA, CONTACTO_WID, NOMBRE_APELLIDO_CONTACTO, N_VISITAS
FROM (
    SELECT CATEGORIA,
           CONTACTO_WID,
           NOMBRE_APELLIDO_CONTACTO,
           COUNT(DISTINCT VISITAS) AS N_VISITAS,
           ROW_NUMBER() OVER (PARTITION BY CATEGORIA ORDER BY DBMS_RANDOM.VALUE) AS RN
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND CONTACTO_WID IS NOT NULL
      AND VISITAS IS NOT NULL
    GROUP BY CATEGORIA, CONTACTO_WID, NOMBRE_APELLIDO_CONTACTO
)
WHERE RN = 1
ORDER BY CATEGORIA;





SELECT CONTACTO_WID,
       NOMBRE_APELLIDO_CONTACTO,
       RED_NEGOCIO_VISITA,
       MES,
       COUNT(DISTINCT VISITAS) AS N_VISITAS
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND CONTACTO_WID IN (111, 222, 333, 444)   -- los contactos elegidos
GROUP BY CONTACTO_WID, NOMBRE_APELLIDO_CONTACTO, RED_NEGOCIO_VISITA, MES
ORDER BY NOMBRE_APELLIDO_CONTACTO, RED_NEGOCIO_VISITA, MES;





SELECT DISTINCT
       CONTACTO_WID,
       NOMBRE_APELLIDO_CONTACTO,
       AGENTE,
       RED_NEGOCIO_VISITA,
       MES,
       VISITAS,
       ID_VISITA
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND CONTACTO_WID = 111      -- el contacto que no cuadre
ORDER BY MES, VISITAS;
