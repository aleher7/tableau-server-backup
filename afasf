SELECT (SELECT SUM(U_GROSS) FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='25084488SO') AS UB_ORIGEN,
       (SELECT SUM(A_NET)   FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='25084488SO') AS IMP_ORIGEN,
       (SELECT SUM(UNIDADES_BRUTAS) FROM ANL_ANALISIS_CAMPAÑAS_ESP_TMP2
         WHERE ID_ORDER='25084488SO' AND DATA_SOURCE=1) AS UB_VISTA,
       (SELECT SUM(IMPORTE_NETO) FROM ANL_ANALISIS_CAMPAÑAS_ESP_TMP2
         WHERE ID_ORDER='25084488SO' AND DATA_SOURCE=1) AS IMP_VISTA
FROM dual;



SELECT SUBSTR(ID_ORDER,1,2) AS PREFIJO,
       EXTRACT(YEAR FROM DATE_CONFIRMATION) AS AÑO_CONFIRMACION,
       COUNT(DISTINCT ID_ORDER) AS PEDIDOS
FROM ANL_F_SELLIN
WHERE ID_BU='ESP' AND SUBSTR(ID_ORDER,1,2) IN ('24','25','26')
GROUP BY SUBSTR(ID_ORDER,1,2), EXTRACT(YEAR FROM DATE_CONFIRMATION)
ORDER BY 1,2;


SELECT COLUMN_NAME, DATA_TYPE
FROM USER_TAB_COLUMNS
WHERE TABLE_NAME='ANL_F_SELLIN'
  AND (DATA_TYPE LIKE 'DATE%' OR DATA_TYPE LIKE 'TIMESTAMP%'
       OR COLUMN_NAME LIKE '%FECHA%' OR COLUMN_NAME LIKE '%DATE%');


SELECT ID_ORDER, MIN(<columna_fecha_pedido>) AS FECHA_PEDIDO,
       MIN(DATE_CONFIRMATION) AS FECHA_CONFIRMACION
FROM ANL_F_SELLIN
WHERE ID_BU='ESP' AND ID_ORDER IN ('25107862SO','25103285SO','25083608SO')
GROUP BY ID_ORDER;
