-- 1. Versión ACTUAL
CREATE TABLE tmp_r12_actual AS
WITH
UNIDADES_MARCA AS (
  SELECT YEAR AÑO, MONTH MES, BRAND MARCA, SUM(U_GROSS) AS UNIDADES_BRUTAS
  FROM TABLEAU_SELFSERVICE A
  WHERE data_source=1 AND id_bu='INT'
  GROUP BY YEAR, MONTH, BRAND
),
UNIDADES_MARCA_AÑO AS (
  SELECT A.AÑO, A.MES, A.MARCA, SUM(NVL(B.UNIDADES_BRUTAS,0)) AS UNIDADES_BRUTAS_AÑO
  FROM UNIDADES_MARCA A
  LEFT JOIN UNIDADES_MARCA B
    ON A.MARCA=B.MARCA
   AND (CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) > CONCAT(TO_CHAR(B.AÑO),CASE WHEN B.MES<=9 THEN CONCAT('0',TO_CHAR(B.MES)) ELSE TO_CHAR(B.MES) END)
    AND CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) <= CONCAT(TO_CHAR(B.AÑO+1),CASE WHEN B.MES<=9 THEN CONCAT('0',TO_CHAR(B.MES)) ELSE TO_CHAR(B.MES) END))
  GROUP BY A.AÑO, A.MES, A.MARCA
  ORDER BY A.AÑO, A.MES
),
TAM_MARCA AS (
  SELECT MARCA,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) AS TAM,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) AS PREV_TAM,
    (CASE WHEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) <> 0
          THEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) / SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END)
          ELSE 1 END) AS FACTOR
  FROM UNIDADES_MARCA_AÑO
  GROUP BY MARCA
),
PRIMERA_VENTA_TOTAL AS (
  SELECT productcode_tableau, FLG_LANZAMIENTO, FECHA_PRIMERA_VENTA,
    EXTRACT(YEAR FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1)) || (CASE WHEN EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1))<=9 THEN '0'||TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1))) ELSE TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1))) END) AS FECHA_FORECAST,
    EXTRACT(YEAR FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12)) || (CASE WHEN EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12))<=9 THEN '0'||TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12))) ELSE TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12))) END) AS FECHA_1_ANIO_VENTA,
    EXTRACT(YEAR FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24)) || (CASE WHEN EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24))<=9 THEN '0'||TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24))) ELSE TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24))) END) AS FECHA_2_ANIO_VENTA
  FROM (
    SELECT A.productcode_tableau,
      MIN(CONCAT(TO_CHAR(YEAR),CASE WHEN MONTH<=9 THEN CONCAT('0',TO_CHAR(MONTH)) ELSE TO_CHAR(MONTH) END)) AS FECHA_PRIMERA_VENTA,
      MIN(DATE_CONFIRMATION) AS DIA_PRIMERA_VENTA,
      MAX(CASE WHEN B.LOCAL_PRODUCT_CODE IS NOT NULL THEN 1 ELSE 0 END) AS FLG_LANZAMIENTO
    FROM TABLEAU_SELFSERVICE A
    LEFT JOIN (SELECT DISTINCT LOCAL_PRODUCT_CODE
        FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_LOCAL L
        INNER JOIN CLABS_ANL_PRO.ANL_M_PROD_CATALOG_CORP C ON L.GROUPED_GOLD_CODE=C.GROUPED_GOLD_CODE
        WHERE BUSINESS_UNIT='INT' AND plan_year_launch IS NOT NULL) B ON A.productcode_tableau=B.LOCAL_PRODUCT_CODE
    WHERE id_bu='INT' AND data_source=1 AND u_gross>0
    GROUP BY A.productcode_tableau
    UNION ALL
    SELECT jde_product_code productcode_tableau,
      MIN(CONCAT(TO_CHAR(EXTRACT(YEAR FROM IDSECUENCIA)),CASE WHEN EXTRACT(MONTH FROM IDSECUENCIA)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM IDSECUENCIA))) ELSE TO_CHAR(EXTRACT(MONTH FROM IDSECUENCIA)) END)) AS FECHA_PRIMERA_VENTA,
      MIN(IDSECUENCIA) AS DIA_PRIMERA_VENTA,
      MAX(CASE WHEN B.LOCAL_PRODUCT_CODE IS NOT NULL THEN 1 ELSE 0 END) AS FLG_LANZAMIENTO
    FROM ANL_SUPPLY_DEMAND_REVIEW A
    LEFT JOIN (SELECT DISTINCT LOCAL_PRODUCT_CODE
        FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_LOCAL L
        INNER JOIN CLABS_ANL_PRO.ANL_M_PROD_CATALOG_CORP C ON L.GROUPED_GOLD_CODE=C.GROUPED_GOLD_CODE
        WHERE BUSINESS_UNIT='INT' AND plan_year_launch IS NOT NULL) B ON A.jde_product_code=B.LOCAL_PRODUCT_CODE
    WHERE A.business_unit='INT' AND jde_product_code IS NOT NULL
      AND jde_product_code NOT IN (SELECT DISTINCT productcode_tableau
                                   FROM TABLEAU_SELFSERVICE A
                                   WHERE id_bu='INT' AND data_source=1 AND u_gross>0)
    GROUP BY jde_product_code
  )
),
MESES_PROD AS (
  SELECT B.PRODUCTCODE_TABLEAU, C.AÑO, C.MES
  FROM PRIMERA_VENTA_TOTAL B
  LEFT JOIN (
    SELECT DISTINCT YEAR AÑO, MONTH MES
    FROM TABLEAU_SELFSERVICE
    WHERE id_bu='INT' AND DATA_SOURCE=1
    UNION
    SELECT EXTRACT(YEAR FROM SYSDATE) AS AÑO, EXTRACT(MONTH FROM SYSDATE) AS MES FROM DUAL
  ) C ON 1=1
  WHERE CONCAT(TO_CHAR(C.AÑO),CASE WHEN C.MES<=9 THEN CONCAT('0',TO_CHAR(C.MES)) ELSE TO_CHAR(C.MES) END) >= B.FECHA_PRIMERA_VENTA
    AND CONCAT(TO_CHAR(C.AÑO),CASE WHEN C.MES<=9 THEN CONCAT('0',TO_CHAR(C.MES)) ELSE TO_CHAR(C.MES) END) <= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
  ORDER BY B.PRODUCTCODE_TABLEAU, C.AÑO, C.MES
),
UNIDADES_PROD_AÑO AS (
  SELECT A.AÑO, A.MES, A.PRODUCTCODE_TABLEAU, SUM(NVL(B.U_GROSS,0)) AS UNIDADES_AJUSTADAS_AÑO
  FROM MESES_PROD A
  LEFT JOIN TABLEAU_SELFSERVICE B
    ON A.PRODUCTCODE_TABLEAU=B.PRODUCTCODE_TABLEAU
   AND (CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) > CONCAT(TO_CHAR(B.YEAR),CASE WHEN B.MONTH<=9 THEN CONCAT('0',TO_CHAR(B.MONTH)) ELSE TO_CHAR(B.MONTH) END)
    AND CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) <= CONCAT(TO_CHAR(B.YEAR+1),CASE WHEN B.MONTH<=9 THEN CONCAT('0',TO_CHAR(B.MONTH)) ELSE TO_CHAR(B.MONTH) END))
  WHERE DATA_SOURCE=1 AND ID_BU='INT'
  GROUP BY A.AÑO, A.MES, A.PRODUCTCODE_TABLEAU
  ORDER BY A.AÑO, A.MES
),
TAM_PROD AS (
  SELECT PRODUCTCODE_TABLEAU,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) AS TAM,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) AS PREV_TAM,
    (CASE WHEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) <> 0
          THEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) / SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END)
          ELSE 1 END) AS FACTOR
  FROM UNIDADES_PROD_AÑO
  GROUP BY PRODUCTCODE_TABLEAU
),
PROD_MARCA AS (
  SELECT DISTINCT PRODUCTCODE_TABLEAU, BRAND
  FROM TABLEAU_SELFSERVICE
  WHERE ID_BU='INT' AND data_source=1
),
FORECAST AS (
  SELECT DISTINCT DFAJSY AS ANIO, DFMNTH AS MES, TRIM(DFLITM) AS LOCAL_PRODUCT_CODE,
    SUM(DFFQT/10000) AS UNIDADES_FORECAST,
    DFTYPF AS TIPO_FORECAST,
    TO_NUMBER(SUBSTR((to_char(trunc(date_conversion.from_julian(DFTRDJ),'MM'),'YYYYMMDD')),1,6)) AS MES_FECHA_FORECAST,
    TO_NUMBER(SUBSTR((to_char(trunc(date_conversion.from_julian(DFDRQJ),'MM'),'YYYYMMDD')),1,6)) AS MES_PREVISION_FORECAST,
    TO_DATE(to_char(trunc(date_conversion.from_julian(DFTRDJ),'MM'),'YYYYMMDD'),'YYYYMMDD') AS DIA_FECHA_FORECAST,
    TO_DATE(to_char(trunc(date_conversion.from_julian(DFDRQJ),'MM'),'YYYYMMDD'),'YYYYMMDD') AS DIA_PREVISION_FORECAST
  FROM CLABS_STG_PRO.STG_JDE_IFCSA_F553460A
  WHERE DFTYPF = 'FI'
    AND TRIM(DFMCU) IN (SELECT DISTINCT DESC_ALMACEN FROM ANL_M_ALMACEN WHERE ID_PROCESO = 7)
  GROUP BY DFAJSY, DFMNTH, DFLITM, DFTYPF,
    to_char(trunc(date_conversion.from_julian(DFTRDJ),'MM'),'YYYYMMDD'),
    to_char(trunc(date_conversion.from_julian(DFDRQJ),'MM'),'YYYYMMDD')
  ORDER BY 6,7
)
SELECT AÑO, MES, PRODUCT_CODE, UNIDADES_ROLLING, VUELTA
FROM (
  ---------- 1 año lanzamiento
  SELECT TO_NUMBER(SUBSTR(A.MES_PREVISION_FORECAST,1,4)) AS AÑO,
         TO_NUMBER(SUBSTR(A.MES_PREVISION_FORECAST,5,2)) AS MES,
         B.productcode_tableau PRODUCT_CODE,
         A.UNIDADES_FORECAST AS UNIDADES_ROLLING,
         1 AS VUELTA,
         SYSDATE AS DATE_UPD
  FROM FORECAST A
  INNER JOIN (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) B
     ON A.LOCAL_PRODUCT_CODE=B.productcode_tableau
    AND A.MES_FECHA_FORECAST=B.FECHA_FORECAST      -- <<< NUMBER = VARCHAR2: posible sitio de tu corrección de tipos
  WHERE A.DIA_PREVISION_FORECAST>=ADD_MONTHS(A.DIA_FECHA_FORECAST,1)
    AND A.DIA_PREVISION_FORECAST<=ADD_MONTHS(A.DIA_FECHA_FORECAST,12)
    AND (
         (EXTRACT(YEAR FROM A.DIA_PREVISION_FORECAST)>EXTRACT(YEAR FROM SYSDATE) AND EXTRACT(MONTH FROM A.DIA_PREVISION_FORECAST)<EXTRACT(MONTH FROM SYSDATE))
      OR (EXTRACT(YEAR FROM A.DIA_PREVISION_FORECAST)=EXTRACT(YEAR FROM SYSDATE) AND EXTRACT(MONTH FROM A.DIA_PREVISION_FORECAST)>=EXTRACT(MONTH FROM SYSDATE))
    )
 
  UNION ALL
 
  ---------- 2 año lanzamiento
  SELECT F.AÑO+1 AS AÑO,
         F.MES AS MES,
         D.productcode_tableau PRODUCT_CODE,
         ROUND(C.UNIDADES*(F.UNIDADES_BRUTAS/G.UNIDADES_BRUTAS_AÑO)) AS UNIDADES_ROLLING,
         2 AS VUELTA,
         SYSDATE
  FROM (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) D
  LEFT JOIN CLABS_STG_PRO.STG_ESP_LANZAMIENTO_SEGUNDO_ANIO C
         ON C.PRODUCTO_AGRUPADO=1
  LEFT JOIN PROD_MARCA E
         ON D.PRODUCTCODE_TABLEAU=E.PRODUCTCODE_TABLEAU
  LEFT JOIN UNIDADES_MARCA F
         ON E.BRAND=F.MARCA
        AND (CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) >= D.FECHA_1_ANIO_VENTA
         AND CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) <  D.FECHA_2_ANIO_VENTA)
  LEFT JOIN UNIDADES_MARCA_AÑO G
         ON F.MARCA=G.MARCA
        AND CONCAT(TO_CHAR(G.AÑO),CASE WHEN G.MES<=9 THEN CONCAT('0',TO_CHAR(G.MES)) ELSE TO_CHAR(G.MES) END) = CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
  WHERE (CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) >= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
     AND CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) <  CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)+1),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END))
 
  UNION ALL
 
  ---------- Más de 2 años del lanzamiento en los próximos 12 meses
  SELECT A.YEAR+1 AS AÑO, A.MONTH MES, A.PRODUCTCODE_TABLEAU PRODUCT_CODE,
         ROUND(SUM(A.U_GROSS*B.FACTOR)) AS UNIDADES_ROLLING,
         3 AS VUELTA,
         SYSDATE
  FROM TABLEAU_SELFSERVICE A
  LEFT JOIN PROD_MARCA D ON A.PRODUCTCODE_TABLEAU=D.PRODUCTCODE_TABLEAU
  LEFT JOIN TAM_MARCA B ON D.BRAND=B.MARCA
  LEFT JOIN (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) C
         ON A.PRODUCTCODE_TABLEAU=C.PRODUCTCODE_TABLEAU
  WHERE ID_BU='INT' AND DATA_SOURCE=1
    AND (CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) >= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
     AND CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) <  CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)+1),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END))
    AND (CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) >= C.FECHA_2_ANIO_VENTA AND C.FECHA_2_ANIO_VENTA IS NOT NULL)
  GROUP BY A.YEAR, A.MONTH, A.PRODUCTCODE_TABLEAU
 
  UNION ALL
 
  ---------- Más de 2 años del lanzamiento actualmente
  SELECT A.YEAR+1 AS AÑO, A.MONTH MES, A.PRODUCTCODE_TABLEAU PRODUCT_CODE,
         ROUND(SUM(A.U_GROSS*B.FACTOR)) AS UNIDADES_ROLLING,
         4 AS VUELTA,
         SYSDATE
  FROM TABLEAU_SELFSERVICE A
  LEFT JOIN TAM_PROD B ON A.PRODUCTCODE_TABLEAU=B.PRODUCTCODE_TABLEAU
  LEFT JOIN (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) C
         ON A.PRODUCTCODE_TABLEAU=C.PRODUCTCODE_TABLEAU
  WHERE ID_BU='INT' AND DATA_SOURCE=1
    AND (CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) >= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
     AND CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) <  CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)+1),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END))
    AND (C.FECHA_2_ANIO_VENTA IS NULL)
  GROUP BY A.YEAR, A.MONTH, A.PRODUCTCODE_TABLEAU
);
 
-- 2. Versión NUEVA
CREATE TABLE tmp_r12_nueva AS
WITH
UNIDADES_MARCA AS (
  SELECT YEAR AÑO, MONTH MES, BRAND MARCA, SUM(U_GROSS) AS UNIDADES_BRUTAS
  FROM TABLEAU_SELFSERVICE A
  WHERE data_source=1 AND id_bu=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT')
  GROUP BY YEAR, MONTH, BRAND
),
UNIDADES_MARCA_AÑO AS (
  SELECT A.AÑO, A.MES, A.MARCA, SUM(NVL(B.UNIDADES_BRUTAS,0)) AS UNIDADES_BRUTAS_AÑO
  FROM UNIDADES_MARCA A
  LEFT JOIN UNIDADES_MARCA B
    ON A.MARCA=B.MARCA
   AND (CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) > CONCAT(TO_CHAR(B.AÑO),CASE WHEN B.MES<=9 THEN CONCAT('0',TO_CHAR(B.MES)) ELSE TO_CHAR(B.MES) END)
    AND CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) <= CONCAT(TO_CHAR(B.AÑO+1),CASE WHEN B.MES<=9 THEN CONCAT('0',TO_CHAR(B.MES)) ELSE TO_CHAR(B.MES) END))
  GROUP BY A.AÑO, A.MES, A.MARCA
  ORDER BY A.AÑO, A.MES
),
TAM_MARCA AS (
  SELECT MARCA,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) AS TAM,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) AS PREV_TAM,
    (CASE WHEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) <> 0
          THEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END) / SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_BRUTAS_AÑO ELSE 0 END)
          ELSE 1 END) AS FACTOR
  FROM UNIDADES_MARCA_AÑO
  GROUP BY MARCA
),
PRIMERA_VENTA_TOTAL AS (
  SELECT productcode_tableau, FLG_LANZAMIENTO, FECHA_PRIMERA_VENTA,
    EXTRACT(YEAR FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1)) || (CASE WHEN EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1))<=9 THEN '0'||TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1))) ELSE TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,-1))) END) AS FECHA_FORECAST,
    EXTRACT(YEAR FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12)) || (CASE WHEN EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12))<=9 THEN '0'||TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12))) ELSE TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,12))) END) AS FECHA_1_ANIO_VENTA,
    EXTRACT(YEAR FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24)) || (CASE WHEN EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24))<=9 THEN '0'||TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24))) ELSE TO_CHAR(EXTRACT(MONTH FROM ADD_MONTHS(DIA_PRIMERA_VENTA,24))) END) AS FECHA_2_ANIO_VENTA
  FROM (
    SELECT A.productcode_tableau,
      MIN(CONCAT(TO_CHAR(YEAR),CASE WHEN MONTH<=9 THEN CONCAT('0',TO_CHAR(MONTH)) ELSE TO_CHAR(MONTH) END)) AS FECHA_PRIMERA_VENTA,
      MIN(DATE_CONFIRMATION) AS DIA_PRIMERA_VENTA,
      MAX(CASE WHEN B.LOCAL_PRODUCT_CODE IS NOT NULL THEN 1 ELSE 0 END) AS FLG_LANZAMIENTO
    FROM TABLEAU_SELFSERVICE A
    LEFT JOIN (SELECT DISTINCT LOCAL_PRODUCT_CODE
        FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_LOCAL L
        INNER JOIN CLABS_ANL_PRO.ANL_M_PROD_CATALOG_CORP C ON L.GROUPED_GOLD_CODE=C.GROUPED_GOLD_CODE
        WHERE BUSINESS_UNIT=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND plan_year_launch IS NOT NULL) B ON A.productcode_tableau=B.LOCAL_PRODUCT_CODE
    WHERE id_bu=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND data_source=1 AND u_gross>0
    GROUP BY A.productcode_tableau
    UNION ALL
    SELECT jde_product_code productcode_tableau,
      MIN(CONCAT(TO_CHAR(EXTRACT(YEAR FROM IDSECUENCIA)),CASE WHEN EXTRACT(MONTH FROM IDSECUENCIA)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM IDSECUENCIA))) ELSE TO_CHAR(EXTRACT(MONTH FROM IDSECUENCIA)) END)) AS FECHA_PRIMERA_VENTA,
      MIN(IDSECUENCIA) AS DIA_PRIMERA_VENTA,
      MAX(CASE WHEN B.LOCAL_PRODUCT_CODE IS NOT NULL THEN 1 ELSE 0 END) AS FLG_LANZAMIENTO
    FROM ANL_SUPPLY_DEMAND_REVIEW A
    LEFT JOIN (SELECT DISTINCT LOCAL_PRODUCT_CODE
        FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_LOCAL L
        INNER JOIN CLABS_ANL_PRO.ANL_M_PROD_CATALOG_CORP C ON L.GROUPED_GOLD_CODE=C.GROUPED_GOLD_CODE
        WHERE BUSINESS_UNIT=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND plan_year_launch IS NOT NULL) B ON A.jde_product_code=B.LOCAL_PRODUCT_CODE
    WHERE A.business_unit=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND jde_product_code IS NOT NULL
      AND jde_product_code NOT IN (SELECT DISTINCT productcode_tableau
                                   FROM TABLEAU_SELFSERVICE A
                                   WHERE id_bu=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND data_source=1 AND u_gross>0)
    GROUP BY jde_product_code
  )
),
MESES_PROD AS (
  SELECT B.PRODUCTCODE_TABLEAU, C.AÑO, C.MES
  FROM PRIMERA_VENTA_TOTAL B
  LEFT JOIN (
    SELECT DISTINCT YEAR AÑO, MONTH MES
    FROM TABLEAU_SELFSERVICE
    WHERE id_bu=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND DATA_SOURCE=1
    UNION
    SELECT EXTRACT(YEAR FROM SYSDATE) AS AÑO, EXTRACT(MONTH FROM SYSDATE) AS MES FROM DUAL
  ) C ON 1=1
  WHERE CONCAT(TO_CHAR(C.AÑO),CASE WHEN C.MES<=9 THEN CONCAT('0',TO_CHAR(C.MES)) ELSE TO_CHAR(C.MES) END) >= B.FECHA_PRIMERA_VENTA
    AND CONCAT(TO_CHAR(C.AÑO),CASE WHEN C.MES<=9 THEN CONCAT('0',TO_CHAR(C.MES)) ELSE TO_CHAR(C.MES) END) <= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
  ORDER BY B.PRODUCTCODE_TABLEAU, C.AÑO, C.MES
),
UNIDADES_PROD_AÑO AS (
  SELECT A.AÑO, A.MES, A.PRODUCTCODE_TABLEAU, SUM(NVL(B.U_GROSS,0)) AS UNIDADES_AJUSTADAS_AÑO
  FROM MESES_PROD A
  LEFT JOIN TABLEAU_SELFSERVICE B
    ON A.PRODUCTCODE_TABLEAU=B.PRODUCTCODE_TABLEAU
   AND (CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) > CONCAT(TO_CHAR(B.YEAR),CASE WHEN B.MONTH<=9 THEN CONCAT('0',TO_CHAR(B.MONTH)) ELSE TO_CHAR(B.MONTH) END)
    AND CONCAT(TO_CHAR(A.AÑO),CASE WHEN A.MES<=9 THEN CONCAT('0',TO_CHAR(A.MES)) ELSE TO_CHAR(A.MES) END) <= CONCAT(TO_CHAR(B.YEAR+1),CASE WHEN B.MONTH<=9 THEN CONCAT('0',TO_CHAR(B.MONTH)) ELSE TO_CHAR(B.MONTH) END))
  WHERE DATA_SOURCE=1 AND ID_BU=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT')
  GROUP BY A.AÑO, A.MES, A.PRODUCTCODE_TABLEAU
  ORDER BY A.AÑO, A.MES
),
TAM_PROD AS (
  SELECT PRODUCTCODE_TABLEAU,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) AS TAM,
    SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) AS PREV_TAM,
    (CASE WHEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) <> 0
          THEN SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE) AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END) / SUM(CASE WHEN AÑO=EXTRACT(YEAR FROM SYSDATE)-1 AND MES=EXTRACT(MONTH FROM SYSDATE) THEN UNIDADES_AJUSTADAS_AÑO ELSE 0 END)
          ELSE 1 END) AS FACTOR
  FROM UNIDADES_PROD_AÑO
  GROUP BY PRODUCTCODE_TABLEAU
),
PROD_MARCA AS (
  SELECT DISTINCT PRODUCTCODE_TABLEAU, BRAND
  FROM TABLEAU_SELFSERVICE
  WHERE ID_BU=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND data_source=1
),
FORECAST AS (
  SELECT DISTINCT DFAJSY AS ANIO, DFMNTH AS MES, TRIM(DFLITM) AS LOCAL_PRODUCT_CODE,
    SUM(DFFQT/10000) AS UNIDADES_FORECAST,
    DFTYPF AS TIPO_FORECAST,
    TO_NUMBER(SUBSTR((to_char(trunc(date_conversion.from_julian(DFTRDJ),'MM'),'YYYYMMDD')),1,6)) AS MES_FECHA_FORECAST,
    TO_NUMBER(SUBSTR((to_char(trunc(date_conversion.from_julian(DFDRQJ),'MM'),'YYYYMMDD')),1,6)) AS MES_PREVISION_FORECAST,
    TO_DATE(to_char(trunc(date_conversion.from_julian(DFTRDJ),'MM'),'YYYYMMDD'),'YYYYMMDD') AS DIA_FECHA_FORECAST,
    TO_DATE(to_char(trunc(date_conversion.from_julian(DFDRQJ),'MM'),'YYYYMMDD'),'YYYYMMDD') AS DIA_PREVISION_FORECAST
  FROM CLABS_STG_PRO.STG_JDE_IFCSA_F553460A
  WHERE DFTYPF = 'FI'
    AND TRIM(DFMCU) IN (SELECT DISTINCT DESC_ALMACEN FROM ANL_M_ALMACEN WHERE ID_PROCESO = 7)
  GROUP BY DFAJSY, DFMNTH, DFLITM, DFTYPF,
    to_char(trunc(date_conversion.from_julian(DFTRDJ),'MM'),'YYYYMMDD'),
    to_char(trunc(date_conversion.from_julian(DFDRQJ),'MM'),'YYYYMMDD')
  ORDER BY 6,7
)
SELECT AÑO, MES, PRODUCT_CODE, UNIDADES_ROLLING, VUELTA
FROM (
  ---------- 1 año lanzamiento
  SELECT TO_NUMBER(SUBSTR(A.MES_PREVISION_FORECAST,1,4)) AS AÑO,
         TO_NUMBER(SUBSTR(A.MES_PREVISION_FORECAST,5,2)) AS MES,
         B.productcode_tableau PRODUCT_CODE,
         A.UNIDADES_FORECAST AS UNIDADES_ROLLING,
         1 AS VUELTA,
         SYSDATE AS DATE_UPD
  FROM FORECAST A
  INNER JOIN (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) B
     ON A.LOCAL_PRODUCT_CODE=B.productcode_tableau
    AND A.MES_FECHA_FORECAST=B.FECHA_FORECAST      -- <<< NUMBER = VARCHAR2: posible sitio de tu corrección de tipos
  WHERE A.DIA_PREVISION_FORECAST>=ADD_MONTHS(A.DIA_FECHA_FORECAST,1)
    AND A.DIA_PREVISION_FORECAST<=ADD_MONTHS(A.DIA_FECHA_FORECAST,12)
    AND (
         (EXTRACT(YEAR FROM A.DIA_PREVISION_FORECAST)>EXTRACT(YEAR FROM SYSDATE) AND EXTRACT(MONTH FROM A.DIA_PREVISION_FORECAST)<EXTRACT(MONTH FROM SYSDATE))
      OR (EXTRACT(YEAR FROM A.DIA_PREVISION_FORECAST)=EXTRACT(YEAR FROM SYSDATE) AND EXTRACT(MONTH FROM A.DIA_PREVISION_FORECAST)>=EXTRACT(MONTH FROM SYSDATE))
    )
 
  UNION ALL
 
  ---------- 2 año lanzamiento
  SELECT F.AÑO+1 AS AÑO,
         F.MES AS MES,
         D.productcode_tableau PRODUCT_CODE,
         ROUND(C.UNIDADES*(F.UNIDADES_BRUTAS/G.UNIDADES_BRUTAS_AÑO)) AS UNIDADES_ROLLING,
         2 AS VUELTA,
         SYSDATE
  FROM (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) D
  LEFT JOIN CLABS_STG_PRO.STG_ESP_LANZAMIENTO_SEGUNDO_ANIO C
         ON C.PRODUCTO_AGRUPADO=1
  LEFT JOIN PROD_MARCA E
         ON D.PRODUCTCODE_TABLEAU=E.PRODUCTCODE_TABLEAU
  LEFT JOIN UNIDADES_MARCA F
         ON E.BRAND=F.MARCA
        AND (CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) >= D.FECHA_1_ANIO_VENTA
         AND CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) <  D.FECHA_2_ANIO_VENTA)
  LEFT JOIN UNIDADES_MARCA_AÑO G
         ON F.MARCA=G.MARCA
        AND CONCAT(TO_CHAR(G.AÑO),CASE WHEN G.MES<=9 THEN CONCAT('0',TO_CHAR(G.MES)) ELSE TO_CHAR(G.MES) END) = CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
  WHERE (CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) >= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
     AND CONCAT(TO_CHAR(F.AÑO+1),CASE WHEN F.MES<=9 THEN CONCAT('0',TO_CHAR(F.MES)) ELSE TO_CHAR(F.MES) END) <  CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)+1),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END))
 
  UNION ALL
 
  ---------- Más de 2 años del lanzamiento en los próximos 12 meses
  SELECT A.YEAR+1 AS AÑO, A.MONTH MES, A.PRODUCTCODE_TABLEAU PRODUCT_CODE,
         ROUND(SUM(A.U_GROSS*B.FACTOR)) AS UNIDADES_ROLLING,
         3 AS VUELTA,
         SYSDATE
  FROM TABLEAU_SELFSERVICE A
  LEFT JOIN PROD_MARCA D ON A.PRODUCTCODE_TABLEAU=D.PRODUCTCODE_TABLEAU
  LEFT JOIN TAM_MARCA B ON D.BRAND=B.MARCA
  LEFT JOIN (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) C
         ON A.PRODUCTCODE_TABLEAU=C.PRODUCTCODE_TABLEAU
  WHERE ID_BU=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND DATA_SOURCE=1
    AND (CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) >= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
     AND CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) <  CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)+1),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END))
    AND (CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) >= C.FECHA_2_ANIO_VENTA AND C.FECHA_2_ANIO_VENTA IS NOT NULL)
  GROUP BY A.YEAR, A.MONTH, A.PRODUCTCODE_TABLEAU
 
  UNION ALL
 
  ---------- Más de 2 años del lanzamiento actualmente
  SELECT A.YEAR+1 AS AÑO, A.MONTH MES, A.PRODUCTCODE_TABLEAU PRODUCT_CODE,
         ROUND(SUM(A.U_GROSS*B.FACTOR)) AS UNIDADES_ROLLING,
         4 AS VUELTA,
         SYSDATE
  FROM TABLEAU_SELFSERVICE A
  LEFT JOIN TAM_PROD B ON A.PRODUCTCODE_TABLEAU=B.PRODUCTCODE_TABLEAU
  LEFT JOIN (SELECT * FROM PRIMERA_VENTA_TOTAL WHERE FLG_LANZAMIENTO=1) C
         ON A.PRODUCTCODE_TABLEAU=C.PRODUCTCODE_TABLEAU
  WHERE ID_BU=(SELECT DISTINCT M.ID_BU FROM ANL_M_ALMACEN M WHERE M.ID_PROCESO = 7 AND M.DESC_PROCESO = 'ANL_ROLLING12_INT') AND DATA_SOURCE=1
    AND (CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) >= CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END)
     AND CONCAT(TO_CHAR(A.YEAR+1),CASE WHEN A.MONTH<=9 THEN CONCAT('0',TO_CHAR(A.MONTH)) ELSE TO_CHAR(A.MONTH) END) <  CONCAT(TO_CHAR(EXTRACT(YEAR FROM SYSDATE)+1),CASE WHEN EXTRACT(MONTH FROM SYSDATE)<=9 THEN CONCAT('0',TO_CHAR(EXTRACT(MONTH FROM SYSDATE))) ELSE TO_CHAR(EXTRACT(MONTH FROM SYSDATE)) END))
    AND (C.FECHA_2_ANIO_VENTA IS NULL)
  GROUP BY A.YEAR, A.MONTH, A.PRODUCTCODE_TABLEAU
);
