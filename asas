WHEN Tipo_Centro IN ('CENTRO MÉDICO','CLINICA PRIVADA','CONSULTA PRIVADA','HOSPITAL PRIVADO') THEN 'CLIN/H.PR'
WHEN Tipo_Centro IN ('HOSPITAL PÚBLICO') THEN 'HOSPITAL' ELSE 'RESTO' END AS Tipo_Centro_Agrupado,
CODIGO_JDE_CENTRO,
