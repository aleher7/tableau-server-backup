-- 1) Resumen
SELECT a.filas, a.pedidos, a.con_factura, b.claves_repetidas
FROM (SELECT COUNT(*) filas, COUNT(DISTINCT PEDIDO) pedidos, COUNT(FACTURA) con_factura
      FROM <TABLA>) a
CROSS JOIN
     (SELECT COUNT(*) claves_repetidas
      FROM (SELECT 1 FROM <TABLA>
            GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID
            HAVING COUNT(*) > 1)) b;

-- 2) Por año
SELECT 1900 + TRUNC(t.f/1000) anio, COUNT(*) filas, COUNT(DISTINCT p.PEDIDO) pedidos,
       SUM(ORA_HASH(TO_CHAR(p.SDKCOO)||'-'||TO_CHAR(p.PEDIDO)||'-'||TO_CHAR(p.TIPO_PEDIDO)||'-'||TO_CHAR(p.SDLNID)||'-'||NVL(TO_CHAR(p.FACTURA),'-'))) huella
FROM <TABLA> p
JOIN (SELECT SDDOCO, MAX(SDADDJ) f FROM TMP_3_NMACST_F4211_F421x GROUP BY SDDOCO) t
  ON TO_CHAR(t.SDDOCO) = TO_CHAR(p.PEDIDO)
GROUP BY 1900 + TRUNC(t.f/1000)
ORDER BY 1;
