SELECT COUNT(DISTINCT CONTACTOS_VISITADOS_FICHERO) AS cv_fichero
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND CONTACTOS_VISITADOS_FICHERO IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'));


SELECT RED_NEGOCIO_VISITA, COUNT(DISTINCT CONTACTOS_VISITADOS_FICHERO) AS cv_fichero
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND CONTACTOS_VISITADOS_FICHERO IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY RED_NEGOCIO_VISITA
ORDER BY 1;


SELECT SUM(nredes - 1) AS contactos_repetidos
FROM (SELECT CONTACTOS_VISITADOS_FICHERO, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO = 2026
        AND CONTACTOS_VISITADOS_FICHERO IS NOT NULL
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY CONTACTOS_VISITADOS_FICHERO
      HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1);


SELECT COUNT(DISTINCT v.CONTACTOS_VISITADOS_FICHERO) AS visitados_fichero_sin_F
FROM ANL_ACTIVIDAD_ESP v
WHERE v.AÑO = 2026
  AND v.CONTACTOS_VISITADOS_FICHERO IS NOT NULL
  AND (v.ID_VISITA IS NULL OR v.CONTACTO_WID IS NOT NULL OR v.DIVISION IS NULL
       OR v.DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
  AND NOT EXISTS (SELECT 1
                  FROM ANL_ACTIVIDAD_ESP f
                  WHERE f.AGENTE_WID = v.AGENTE_WID
                    AND f.CONTACTO_WID = v.CONTACTO_WID
                    AND f.F_FICH_AGENTE_CONTACTO = 1
                    AND (f.ID_VISITA IS NULL OR f.CONTACTO_WID IS NOT NULL OR f.DIVISION IS NULL
                         OR f.DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')));
