SELECT CASE
         WHEN VISITAS IS NULL         THEN 'ID_VISITA sin VISITAS'
         WHEN VISITAS = ID_VISITA     THEN 'Mismo valor'
         ELSE 'Valores distintos'
       END AS CASO,
       COUNT(DISTINCT ID_VISITA) AS N_IDS
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND ID_VISITA IS NOT NULL
GROUP BY CASE
         WHEN VISITAS IS NULL         THEN 'ID_VISITA sin VISITAS'
         WHEN VISITAS = ID_VISITA     THEN 'Mismo valor'
         ELSE 'Valores distintos'
       END;





SELECT COLUMN_NAME
FROM ALL_TAB_COLUMNS
WHERE TABLE_NAME = 'ANL_ACTIVIDAD_ESP'
  AND (COLUMN_NAME LIKE '%VISITA%' OR COLUMN_NAME LIKE '%ESTADO%'
       OR COLUMN_NAME LIKE '%EVENTO%' OR COLUMN_NAME LIKE '%ACTIVIDAD%')
ORDER BY COLUMN_NAME;



WITH con_red AS (
    SELECT DISTINCT ID_VISITA
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND ID_VISITA IS NOT NULL
      AND RED_NEGOCIO_VISITA IS NOT NULL
      AND RED_NEGOCIO_VISITA <> 'NA'
)
SELECT NVL(a.RED_NEGOCIO_VISITA, '(null)') AS RED,
       NVL(a.SUBTIPO_VISITA, '(null)')     AS SUBTIPO_VISITA,
       NVL(a.DIVISION, '(null)')           AS DIVISION,
       a.MES,
       COUNT(DISTINCT a.ID_VISITA)         AS N_VISITAS
FROM ANL_ACTIVIDAD_ESP a
WHERE a.AÑO = '2026'
  AND a.ID_VISITA IS NOT NULL
  AND (a.RED_NEGOCIO_VISITA IS NULL OR a.RED_NEGOCIO_VISITA = 'NA')
  AND NOT EXISTS (SELECT 1 FROM con_red c WHERE c.ID_VISITA = a.ID_VISITA)
GROUP BY a.RED_NEGOCIO_VISITA, a.SUBTIPO_VISITA, a.DIVISION, a.MES
ORDER BY N_VISITAS DESC;



SELECT *
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND ID_VISITA IS NOT NULL
  AND VISITAS IS NULL
  AND ROWNUM <= 20;
