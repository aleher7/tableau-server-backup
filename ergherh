WITH base AS (
    SELECT CATEGORIA, RED_NEGOCIO_VISITA, VISITAS, CONTACTOS_VISITADOS
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      -- Filtro de fuente de datos "Filtro Contacto No nulo" = True
      AND (   ID_VISITA IS NULL
           OR CONTACTO_WID IS NOT NULL
           OR DIVISION IS NULL
           OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
),
calc AS (
    SELECT
        CASE WHEN GROUPING(CATEGORIA) = 1 THEN 'Total'
             ELSE NVL(CATEGORIA, 'NULL') END AS CATEGORIA,
        GROUPING(CATEGORIA) AS ES_TOTAL,
        COUNT(DISTINCT VISITAS) AS N_VISITAS,
        -- Neo + Plus
        COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA IN ('Red Neo','Red Plus') THEN VISITAS END)             AS V_NEOPLUS,
        COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA IN ('Red Neo','Red Plus') THEN CONTACTOS_VISITADOS END) AS CV_NEOPLUS,
        -- Plus
        COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA = 'Red Plus' THEN VISITAS END)             AS V_PLUS,
        COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA = 'Red Plus' THEN CONTACTOS_VISITADOS END) AS CV_PLUS,
        -- Neo
        COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA = 'Red Neo' THEN VISITAS END)             AS V_NEO,
        COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA = 'Red Neo' THEN CONTACTOS_VISITADOS END) AS CV_NEO
    FROM base
    GROUP BY ROLLUP (CATEGORIA)
)
SELECT
    CATEGORIA,
    N_VISITAS                                         AS "# Visitas",
    ROUND(V_NEOPLUS / NULLIF(CV_NEOPLUS, 0), 1)       AS "Fr Total",
    V_PLUS                                            AS "# V PLUS",
    ROUND(V_PLUS / NULLIF(CV_PLUS, 0), 1)             AS "Fr PLUS",
    ROUND(100 * V_PLUS / NULLIF(N_VISITAS, 0), 1)     AS "Peso V PLUS",
    V_NEO                                             AS "# V NEO",
    ROUND(V_NEO / NULLIF(CV_NEO, 0), 1)               AS "Fr NEO",
    ROUND(100 * V_NEO / NULLIF(N_VISITAS, 0), 1)      AS "Peso V NEO"
FROM calc
WHERE N_VISITAS > 0          -- Tableau no muestra NOVISIT (0 visitas)
ORDER BY ES_TOTAL, CATEGORIA;
