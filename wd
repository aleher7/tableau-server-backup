SELECT COUNT(DISTINCT ID_CONTACTO_SF || '|' || ID_AGENTE) AS PAREJAS_TOTAL,
       COUNT(DISTINCT CASE WHEN TO_NUMBER(MONTH) <= EXTRACT(MONTH FROM SYSDATE - 1)
                           THEN ID_CONTACTO_SF || '|' || ID_AGENTE END) AS PAREJAS_HASTA_MES,
       COUNT(DISTINCT CASE WHEN MONTH IS NULL
                           THEN ID_CONTACTO_SF || '|' || ID_AGENTE END) AS PAREJAS_MES_VACIO,
       COUNT(DISTINCT CASE WHEN ID_AGENTE IS NULL OR ID_CONTACTO_SF IS NULL
                           THEN ID_CONTACTO_SF || '|' || ID_AGENTE END) AS PAREJAS_ID_VACIO
FROM CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
WHERE ORIGEN_TIPO_SF = 'Fichero';


SELECT ORIGEN_TIPO_SF, YEAR, MONTH, PT_CLASIFICACION_CONT, OBJETIVO_MED, COUNT(*)
FROM CLABS_ANL_PRO.ANL_ACTIVIDAD_PT
WHERE ID_CONTACTO_SF = '<ID_CONTACTO>' AND ID_AGENTE = '<ID_AGENTE>'
GROUP BY ORIGEN_TIPO_SF, YEAR, MONTH, PT_CLASIFICACION_CONT, OBJETIVO_MED
ORDER BY MONTH;
