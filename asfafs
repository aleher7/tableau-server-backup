SELECT ID_PRODUCT_CAT, IS_PACK, ID_ITM_PACK, SUM(U_GROSS) UB, SUM(A_NET) IMP, COUNT(*) FILAS
FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='<pedido>'
GROUP BY ID_PRODUCT_CAT, IS_PACK, ID_ITM_PACK;

SELECT NOMBRE_PRODUCTO_COD, IS_PACK, ID_ITM_PACK, SUM(UNIDADES_BRUTAS) UB, SUM(IMPORTE_NETO) IMP, COUNT(*) FILAS
FROM ANL_ANALISIS_CAMAPAÑAS_ESP_TMP2
WHERE ID_ORDER='<pedido>' AND DATA_SOURCE=1
GROUP BY NOMBRE_PRODUCTO_COD, IS_PACK, ID_ITM_PACK;



-- Maestro de artículos JDE (la unión ID_PRODUCT_CAT = TRIM(IMLITM))
SELECT TRIM(IMLITM), COUNT(*) FROM CLABS_STG_PRO.STG_JDE_IFCSA_F4101_ADT
WHERE TRIM(IMLITM) IN (SELECT ID_PRODUCT_CAT FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='<pedido>')
GROUP BY TRIM(IMLITM) HAVING COUNT(*)>1;

-- Catálogo local de producto (y de packs)
SELECT LOCAL_PRODUCT_CODE, BUSINESS_UNIT, COUNT(*) FROM ANL_M_PROD_CATALOG_LOCAL
WHERE BUSINESS_UNIT='ESP'
  AND LOCAL_PRODUCT_CODE IN (SELECT ID_PRODUCT_CAT FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='<pedido>')
GROUP BY LOCAL_PRODUCT_CODE, BUSINESS_UNIT HAVING COUNT(*)>1;

-- Cliente
SELECT CLIENT_CODE, ID_BU, COUNT(*) FROM ANL_M_CLIENT
WHERE ID_BU='ESP'
  AND CLIENT_CODE IN (SELECT ID_DELIVERYCLIENT FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='<pedido>')
GROUP BY CLIENT_CODE, ID_BU HAVING COUNT(*)>1;

-- Agente
SELECT CD_DELEGADO_JDE, COUNT(*) FROM ANL_M_IFC_AGENTES
WHERE CD_DELEGADO_JDE IN (SELECT ID_AGENT FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='<pedido>')
GROUP BY CD_DELEGADO_JDE HAVING COUNT(*)>1;
