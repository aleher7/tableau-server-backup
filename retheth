WITH original AS (
    SELECT PRODUCTO_AGRUPADO_COD,
           MIN(CONCAT(TO_CHAR(AÑO), CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END)) AS FECHA_PRIMERA_VENTA,
           MIN(TO_DATE('01'||CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END||TO_CHAR(AÑO), 'DDMMYYYY')) AS DIA_PRIMERA_VENTA
    FROM anl_venta_interna_esp A
    WHERE data_source = 1 AND UNIDADES_BRUTAS > 0
      --Productos con plan de lanzamiento en el catálogo
      AND PRODUCTO_AGRUPADO_COD IN (
            SELECT DISTINCT LOCAL_GROUPED_PRODUCT_CODE
            FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW
            WHERE BUSINESS_UNIT = 'ESP' AND plan_year_launch IS NOT NULL
              AND LOCAL_GROUPED_PRODUCT_CODE = LOCAL_PRODUCT_CODE)
    GROUP BY PRODUCTO_AGRUPADO_COD
    --Productos aún sin venta
    UNION ALL
    SELECT PRODUCTO_AGRUPADO_COD,
           MIN(CONCAT(TO_CHAR(AÑO), CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END)) AS FECHA_PRIMERA_VENTA,
           MIN(TO_DATE('01'||CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END||TO_CHAR(AÑO), 'DDMMYYYY')) AS DIA_PRIMERA_VENTA
    FROM anl_venta_interna_esp A
    WHERE data_source = 1 AND UNIDADES_BRUTAS = 0
      AND PRODUCTO_AGRUPADO_COD IN (
            SELECT DISTINCT LOCAL_GROUPED_PRODUCT_CODE
            FROM CLABS_ANL_PRO.ANL_M_PROD_CATALOG_FULL_VIEW
            WHERE BUSINESS_UNIT = 'ESP' AND plan_year_launch IS NOT NULL
              AND LOCAL_GROUPED_PRODUCT_CODE = LOCAL_PRODUCT_CODE)
      AND PRODUCTO_AGRUPADO_COD IN (
            SELECT PRODUCTO_AGRUPADO_COD FROM (
                SELECT PRODUCTO_AGRUPADO_COD, MAX(UNIDADES_BRUTAS) AS MAX_BR
                FROM anl_venta_interna_esp WHERE DATA_SOURCE = 1
                GROUP BY PRODUCTO_AGRUPADO_COD
            ) WHERE MAX_BR = 0)
    GROUP BY PRODUCTO_AGRUPADO_COD
),
nueva AS (
    SELECT PRODUCTO_AGRUPADO_COD,
           MIN(CONCAT(TO_CHAR(AÑO), CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END)) AS FECHA_PRIMERA_VENTA,
           MIN(TO_DATE('01'||CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END||TO_CHAR(AÑO), 'DDMMYYYY')) AS DIA_PRIMERA_VENTA
    FROM anl_venta_interna_esp A
    WHERE data_source = 1 AND UNIDADES_BRUTAS > 0
      --Productos con plan de lanzamiento en el catálogo
      AND PRODUCTO_AGRUPADO_COD IN (
            SELECT DISTINCT LOCAL_GROUPED_PRODUCT_CODE
            FROM ANL_M_PROD_CATALOG_LOCAL L
            INNER JOIN ANL_M_PROD_CATALOG_CORP C ON L.GROUPED_GOLD_CODE = C.GROUPED_GOLD_CODE
            WHERE BUSINESS_UNIT = 'ESP' AND plan_year_launch IS NOT NULL
              AND LOCAL_GROUPED_PRODUCT_CODE = LOCAL_PRODUCT_CODE)
    GROUP BY PRODUCTO_AGRUPADO_COD
    --Productos aún sin venta
    UNION ALL
    SELECT PRODUCTO_AGRUPADO_COD,
           MIN(CONCAT(TO_CHAR(AÑO), CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END)) AS FECHA_PRIMERA_VENTA,
           MIN(TO_DATE('01'||CASE WHEN MES<=9 THEN CONCAT('0', TO_CHAR(MES)) ELSE TO_CHAR(MES) END||TO_CHAR(AÑO), 'DDMMYYYY')) AS DIA_PRIMERA_VENTA
    FROM anl_venta_interna_esp A
    WHERE data_source = 1 AND UNIDADES_BRUTAS = 0
      AND PRODUCTO_AGRUPADO_COD IN (
            SELECT DISTINCT LOCAL_GROUPED_PRODUCT_CODE
            FROM ANL_M_PROD_CATALOG_LOCAL L
            INNER JOIN ANL_M_PROD_CATALOG_CORP C ON L.GROUPED_GOLD_CODE = C.GROUPED_GOLD_CODE
            WHERE BUSINESS_UNIT = 'ESP' AND plan_year_launch IS NOT NULL
              AND LOCAL_GROUPED_PRODUCT_CODE = LOCAL_PRODUCT_CODE)
      AND PRODUCTO_AGRUPADO_COD IN (
            SELECT PRODUCTO_AGRUPADO_COD FROM (
                SELECT PRODUCTO_AGRUPADO_COD, MAX(UNIDADES_BRUTAS) AS MAX_BR
                FROM anl_venta_interna_esp WHERE DATA_SOURCE = 1
                GROUP BY PRODUCTO_AGRUPADO_COD
            ) WHERE MAX_BR = 0)
    GROUP BY PRODUCTO_AGRUPADO_COD
)
SELECT 'SOLO_ORIGINAL' AS ORIGEN, o.*
FROM (SELECT * FROM original MINUS SELECT * FROM nueva) o
UNION ALL
SELECT 'SOLO_NUEVA' AS ORIGEN, n.*
FROM (SELECT * FROM nueva MINUS SELECT * FROM original) n;











