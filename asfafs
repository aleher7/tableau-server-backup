SELECT NVL(o.ID_ORDER,c.ID_ORDER) AS ID_ORDER,
       NVL(o.FILAS,0) AS FILAS_ORIGEN, NVL(c.FILAS,0) AS FILAS_VISTA,
       NVL(c.UB,0)-NVL(o.UB,0) AS DIF_UB, NVL(c.IMP,0)-NVL(o.IMP,0) AS DIF_IMP
FROM (SELECT ID_ORDER, COUNT(*) FILAS, SUM(U_GROSS) UB, SUM(A_NET) IMP
      FROM ANL_F_SELLIN
      WHERE ID_BU='ESP' AND DATE_CONFIRMATION >= DATE '2026-01-01' AND DATE_CONFIRMATION < DATE '2026-03-01'
      GROUP BY ID_ORDER) o
FULL OUTER JOIN
     (SELECT ID_ORDER, COUNT(*) FILAS, SUM(UNIDADES_BRUTAS) UB, SUM(IMPORTE_NETO) IMP
      FROM ANL_ANALISIS_CAMAPAÑAS_ESP_TMP2
      WHERE AÑO=2026 AND MES IN (1,2) AND DATA_SOURCE=1 GROUP BY ID_ORDER) c
  ON o.ID_ORDER=c.ID_ORDER
WHERE NVL(o.UB,0)<>NVL(c.UB,0) OR NVL(o.IMP,0)<>NVL(c.IMP,0)
ORDER BY ABS(NVL(c.UB,0)-NVL(o.UB,0)) DESC;


SELECT ID_ORDER, ID_PRODUCT_CAT, IS_PACK, ID_ITM_PACK, ID_AGENT, ID_CAMPAIGN, U_GROSS, A_NET
FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND ID_ORDER='<pedido>';

SELECT ID_ORDER, NOMBRE_PRODUCTO_COD, IS_PACK, ID_ITM_PACK, ID_AGENTE_PEDIDO, CAMPAÑA_COD,
       UNIDADES_BRUTAS, IMPORTE_NETO
FROM ANL_ANALISIS_CAMAPAÑAS_ESP_TMP2 WHERE ID_ORDER='<pedido>' AND DATA_SOURCE=1;



-- agentes
SELECT CD_DELEGADO_JDE, COUNT(*) FROM ANL_M_IFC_AGENTES
WHERE CD_DELEGADO_JDE IS NOT NULL GROUP BY CD_DELEGADO_JDE HAVING COUNT(*)>1;
-- objetivos de campaña
SELECT ID_CAMP, ID_DELEGADO_JDE, COUNT(*) FROM ANL_M_ESP_OBJ_CAMP_DEL
GROUP BY ID_CAMP, ID_DELEGADO_JDE HAVING COUNT(*)>1;
-- clientes
SELECT CLIENT_CODE, ID_BU, COUNT(*) FROM ANL_M_CLIENT
WHERE ID_BU='ESP' GROUP BY CLIENT_CODE, ID_BU HAVING COUNT(*)>1;
-- catálogo local
SELECT LOCAL_PRODUCT_CODE, BUSINESS_UNIT, COUNT(*) FROM ANL_M_PROD_CATALOG_LOCAL
WHERE BUSINESS_UNIT='ESP' GROUP BY LOCAL_PRODUCT_CODE, BUSINESS_UNIT HAVING COUNT(*)>1;
