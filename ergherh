SELECT NVL(CATEGORIA, 'NULL') AS CATEGORIA,
       NOMBRE_APELLIDO_CONTACTO,
       COUNT(DISTINCT VISITAS) AS N_VISITAS,
       COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA = 'Red Plus' THEN VISITAS END) AS V_PLUS,
       COUNT(DISTINCT CASE WHEN RED_NEGOCIO_VISITA = 'Red Neo'  THEN VISITAS END) AS V_NEO
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND (   ID_VISITA IS NULL
       OR CONTACTO_WID IS NOT NULL
       OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY CATEGORIA, NOMBRE_APELLIDO_CONTACTO
ORDER BY N_VISITAS DESC;



SELECT VISITAS,
       COUNT(DISTINCT RED_NEGOCIO_VISITA) AS N_REDES,
       COUNT(DISTINCT CONTACTO_WID)       AS N_CONTACTOS,
       COUNT(DISTINCT NVL(CATEGORIA,'-')) AS N_CATEGORIAS
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026' AND VISITAS IS NOT NULL
GROUP BY VISITAS
HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1
    OR COUNT(DISTINCT CONTACTO_WID) > 1
    OR COUNT(DISTINCT NVL(CATEGORIA,'-')) > 1;



SELECT MES,
       COUNT(DISTINCT VISITAS) AS N_VISITAS,
       COUNT(DISTINCT CONTACTO_WID) AS N_CONTACTOS
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
GROUP BY MES
ORDER BY MES;



SELECT NVL(RED_NEGOCIO_VISITA, '(null)') AS RED,
       CASE WHEN CONTACTO_WID IS NULL THEN 'Sin contacto' ELSE 'Con contacto' END AS CONTACTO,
       COUNT(DISTINCT VISITAS) AS N_VISITAS
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026' AND CATEGORIA IS NULL
GROUP BY RED_NEGOCIO_VISITA, CASE WHEN CONTACTO_WID IS NULL THEN 'Sin contacto' ELSE 'Con contacto' END
ORDER BY N_VISITAS DESC;
