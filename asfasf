SELECT 1900 + TRUNC(SDADDJ/1000) AS anio, COUNT(*) filas, COUNT(DISTINCT SDDOCO) pedidos
FROM TMP_3_NMACST_F4211_F421x
GROUP BY 1900 + TRUNC(SDADDJ/1000)
ORDER BY 1;

SELECT SDDOCO, COUNT(*) filas, COUNT(DISTINCT SDLNID) lineas,
       SUM(ORA_HASH(TO_CHAR(SDKCOO)||'-'||TO_CHAR(SDDOCO)||'-'||TO_CHAR(SDLNID)||'-'||TO_CHAR(SDITM)||'-'||TO_CHAR(SDAN8))) huella
FROM TMP_3_NMACST_F4211_F421x
WHERE TO_CHAR(SDDOCO) IN ('111111','222222')
GROUP BY SDDOCO ORDER BY SDDOCO;
