SELECT AÑO, NVL(DIVISION,'(NULL)') AS division,
       COUNT(*) AS filas_totales,
       SUM(CASE WHEN ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL THEN 1 ELSE 0 END) AS filas_que_se_pierden,
       COUNT(DISTINCT CASE WHEN ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL THEN ID_VISITA END) AS ids_que_se_pierden
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024
  AND (DIVISION IS NULL OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY AÑO, NVL(DIVISION,'(NULL)')
ORDER BY 1, 2;



SELECT AÑO, NVL(DIVISION,'(NULL)') AS division, ORIGEN_TIPO_SF,
       COUNT(*) AS filas, COUNT(DISTINCT ID_VISITA) AS ids,
       COUNT(VISITAS) AS con_visita_contada, COUNT(IMPACTOS) AS con_impactos
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024 AND ID_VISITA IS NOT NULL AND CONTACTO_WID IS NULL
  AND (DIVISION IS NULL OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY AÑO, NVL(DIVISION,'(NULL)'), ORIGEN_TIPO_SF
ORDER BY 1, 2, 3;
