Trayectoria, Nivel_Compromiso, Decil, Residencia, Seg_Orientacion, Grupo, Plan_Activacion, Plan_Formacion,
YTD,MTD,TAM,PREV_YTD,PREV_MTD,PREV_TAM,date_upd,F_Fich_Agente_Contacto,F_Fich_Agente_Contacto_Prov,Flag,
-- AÑADO
NULL ID_SF_ACT,NULL  NAME_VISITA,NULL  MARCA, NULL  TIPO_ACT, NULL SUBTIPO_ACT,NULL SN_ONLINE,NULL TITULO_EVENTO,NULL  CIUDAD_EVENTO,NULL  NUM_PLAZAS,NULL NUM_INSCRITOS,NULL FLAG_INSCRITO,NULL FLAG_ASISTENCIA,
'ACTIVIDAD' ORIGEN_TIPO_SF, 
T_CAPILARES, SEXO, FIBRA_CAPILAR, EXPERTO_COSMETICA, RANGO_EDAD, CENTRO_EXPERTO_COSMETICA, POTENCIAL_IQVIA,
RED_NEGOCIO_VISITA
FROM

(select distinct ID_VISITA,ID_SF_VISITA,CAST(YEAR AS NUMBER) AS AÑO,CAST(MONTH AS NUMBER) AS MES,
CAST(DAY AS NUMBER) AS DIA, Tipo_Visita,Subtipo_Visita,Visita_CLM,Estado_Visita,
A.Division,Gerente,Agente_WID,Contacto_WID,Agente,Cd_Delegado_Jde, Estado_Agente, Nombre_Apellido_Contacto, Estatus_Especialidad, Especialidad_Principal, Especialidad_Resumen, 
Tipo, Subtipo, Subtipo_Contacto, Perfil, Zona, Provincia_Agente, Producto_Reporte,
Visitas,Visitas_Fichero,Visitas_Presenciales,Llamadas,Videollamada,Actividad,Comida,Prospecciones,Acompañamiento,Formación, 
Contactos_Visitados,Contactos_Visitados_Fichero,Impactos,Dias_Trabajados_Agentes,Visitas_Sin_Producto, Agentes_Visitados, Agentes_Visitados_Fichero,
Nombre_Centro, Codigo_Postal_Centro, Ciudad_Centro, Provincia_Centro, Direccion_Centro,TIPO_CENTRO,CODIGO_JDE_CENTRO,
Orientacion_al_dispensing, Visitas_Red_Care, Visitas_Red_Derm, Visitas_Red_Skin, Perfil_Cosmetico, Potencial_de_Receta, Categoria,
Ciclo_Vida_Cliente Trayectoria, Ciclo_Vida_Cliente_Plus Trayectoria_Plus, Ciclo_Vida_Cliente_Neo Trayectoria_Neo, Nivel_Compromiso, Decil, Residencia, Seg_Orientacion,
Grupo, Plan_Activacion, Plan_Formacion,
(CASE WHEN A.Fecha_Visita IS NOT NULL THEN
(CASE WHEN EXTRACT(YEAR FROM SYSDATE)=A.YEAR AND A.MONTH < EXTRACT(MONTH FROM SYSDATE) THEN 1  
      WHEN EXTRACT(YEAR FROM SYSDATE)=A.YEAR AND A.MONTH = EXTRACT(MONTH FROM SYSDATE) AND EXTRACT(DAY FROM TO_DATE(SUBSTR(A.Fecha_Visita,1,4)||'-'||SUBSTR(A.Fecha_Visita,5,2)||'-'||SUBSTR(A.Fecha_Visita,7,2), 'YYYY-MM-DD'))<= EXTRACT(DAY FROM SYSDATE) THEN 1 
      ELSE 0 END) ELSE 0 END) AS YTD,
(CASE WHEN A.Fecha_Visita IS NOT NULL THEN
(CASE WHEN EXTRACT(YEAR FROM SYSDATE)=A.YEAR 
          AND EXTRACT(MONTH FROM SYSDATE)=A.MONTH
          AND EXTRACT(DAY FROM TO_DATE(SUBSTR(A.Fecha_Visita,1,4)||'-'||SUBSTR(A.Fecha_Visita,5,2)||'-'||SUBSTR(A.Fecha_Visita,7,2), 'YYYY-MM-DD'))<= EXTRACT(DAY FROM SYSDATE)
          THEN 1 ELSE 0 END) ELSE 0 END) AS MTD,
(CASE   WHEN EXTRACT(MONTH FROM SYSDATE) = 12  AND A.YEAR=EXTRACT(YEAR FROM SYSDATE) 
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 11 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 11) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (12))) 
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 10 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 10) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (11,12)))
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 09 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 09) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (10,11,12))) 
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 08 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 08) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (09,10,11,12))) 
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 07 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 07) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (08,09,10,11,12))) 
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 06 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 06) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (07,08,09,10,11,12)))
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 05 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 05) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (06,07,08,09,10,11,12)))
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 04 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 04) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (05,06,07,08,09,10,11,12)))
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 03 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 03) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (04,05,06,07,08,09,10,11,12)))
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 02 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH BETWEEN 01 AND 02) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (03,04,05,06,07,08,09,10,11,12)))
        THEN 1
        WHEN EXTRACT(MONTH FROM SYSDATE) = 01 AND 
        ((A.YEAR=EXTRACT(YEAR FROM SYSDATE) AND A.MONTH=01) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH IN (02,03,04,05,06,07,08,09,10,11,12)))
        THEN 1     
ELSE 0 END) TAM,
(CASE WHEN A.Fecha_Visita IS NOT NULL THEN
(CASE WHEN (EXTRACT(YEAR FROM SYSDATE)-1)=A.YEAR AND A.MONTH < EXTRACT(MONTH FROM SYSDATE) THEN 1
      WHEN (EXTRACT(YEAR FROM SYSDATE)-1)=A.YEAR AND A.MONTH = EXTRACT(MONTH FROM SYSDATE) AND EXTRACT(DAY FROM TO_DATE(SUBSTR(A.Fecha_Visita,1,4)||'-'||SUBSTR(A.Fecha_Visita,5,2)||'-'||SUBSTR(A.Fecha_Visita,7,2), 'YYYY-MM-DD'))<= EXTRACT(DAY FROM SYSDATE)
      THEN 1 ELSE 0 END) ELSE 0 END) PREV_YTD,
(CASE WHEN A.Fecha_Visita IS NOT NULL THEN
(CASE WHEN (EXTRACT(YEAR FROM SYSDATE)-1)=A.YEAR AND EXTRACT(MONTH FROM SYSDATE)=A.MONTH 
            AND EXTRACT(DAY FROM TO_DATE(SUBSTR(A.Fecha_Visita,1,4)||'-'||SUBSTR(A.Fecha_Visita,5,2)||'-'||SUBSTR(A.Fecha_Visita,7,2), 'YYYY-MM-DD'))<= EXTRACT(DAY FROM SYSDATE)
      THEN 1 ELSE 0 END) ELSE 0 END) PREV_MTD,
(CASE    WHEN EXTRACT(MONTH FROM SYSDATE) = 12 AND A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 11 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 11) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (12))) 
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 10 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 10) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (11,12)))
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 09 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 09) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (10,11,12))) 
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 08 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 08) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (09,10,11,12))) 
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 07 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 07) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (08,09,10,11,12))) 
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 06 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 06) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (07,08,09,10,11,12)))
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 05 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 05) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (06,07,08,09,10,11,12)))
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 04 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 04) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (05,06,07,08,09,10,11,12)))
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 03 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 03) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (04,05,06,07,08,09,10,11,12)))
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 02 AND 
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH BETWEEN 01 AND 02) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (03,04,05,06,07,08,09,10,11,12)))
		THEN 1
		WHEN EXTRACT(MONTH FROM SYSDATE) = 01 AND
		((A.YEAR=EXTRACT(YEAR FROM SYSDATE)-1 AND A.MONTH=01) OR (A.YEAR=EXTRACT(YEAR FROM SYSDATE)-2 AND A.MONTH IN (02,03,04,05,06,07,08,09,10,11,12)))
		THEN 1
ELSE 0 END) PREV_TAM,
TO_CHAR(DATE_UPD_TABLA,'DD/MM/YYYY, HH24:MI') AS DATE_UPD,
NVL(Fich_Agente_Contacto,0) AS F_Fich_Agente_Contacto,NVL(Fich_Agente_Contacto_Prov,0) AS F_Fich_Agente_Contacto_Prov,
flag_dupli.Flag,
T_CAPILARES, SEXO, FIBRA_CAPILAR, EXPERTO_COSMETICA, RANGO_EDAD, CENTRO_EXPERTO_COSMETICA, POTENCIAL_IQVIA,
RED_NEGOCIO_VISITA
FROM
(

SELECT ACT.ID_VISITA, ACT.ID_SF_VISITA, ACT.FECHA_VISITA Fecha_Visita, SUBSTR(ACT.FECHA_VISITA,1,4) YEAR, SUBSTR(ACT.FECHA_VISITA,5,2) MONTH,
  SUBSTR(ACT.FECHA_VISITA,7,2) DAY,
   ACT.TIPO_VISITA Tipo_Visita, ACT.SUBTIPO_VISITA Subtipo_Visita, ACT.VISITA_CLM Visita_CLM, ACT.ESTADO_VISITA Estado_Visita,
 CASE  WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') THEN ACT.ID_VISITA
       WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') THEN ACT.ID_VISITA END Visitas,
  CASE  WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') and ACT.FICHERO_FLAG = '1' THEN ACT.ID_VISITA
        WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND  ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') and ACT.FICHERO_FLAG = '1' THEN ACT.ID_VISITA END Visitas_Fichero,
 CASE  WHEN ACT.TIPO_VISITA IN ('Visita Presencial') THEN ACT.ID_VISITA END Visitas_Presenciales,
  CASE  WHEN ACT.TIPO_VISITA IN ('Llamada telefónica') THEN ACT.ID_VISITA END Llamadas,
    CASE  WHEN ACT.TIPO_VISITA IN ('Visita Remota (videollamada)') THEN ACT.ID_VISITA END Videollamada,
 CASE  WHEN ACT.TIPO_VISITA IN ('Vacaciones','Enfermedad','Reunión','Organización','Congreso', 'Webinar grupal a clientes', 'Formación grupal a clientes')  THEN ACT.ID_VISITA END Actividad,    
  CASE  WHEN ACT.SUBTIPO_VISITA IN ('Comida') THEN ACT.ID_VISITA END Comida,    
  CASE  WHEN ACT.SUBTIPO_VISITA IN ('Prospección') THEN ACT.ID_VISITA END Prospecciones,    
  CASE  WHEN ACT.SUBTIPO_VISITA IN ('Acompañamiento') THEN ACT.ID_VISITA END Acompañamiento,    
  CASE  WHEN ACT.SUBTIPO_VISITA IN ('Formación') THEN ACT.ID_VISITA END Formación, 
 CASE WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') THEN ACT.CONTACTO_WID
      WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') THEN ACT.CONTACTO_WID END Contactos_Visitados,
  CASE WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') and ACT.FICHERO_FLAG = '1' THEN ACT.CONTACTO_WID
       WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') and ACT.FICHERO_FLAG = '1' THEN ACT.CONTACTO_WID END Contactos_Visitados_Fichero, 
 CASE  WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') AND ACT.PRODUCTO_REPORTE_WID >0 THEN ACT.NOMBRE_PROD_REP||ACT.ID_VISITA
       WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') AND ACT.PRODUCTO_REPORTE_WID >0 THEN ACT.NOMBRE_PROD_REP||ACT.ID_VISITA END Impactos,

 case when (CASE  WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') THEN ACT.FECHA_VISITA
                 WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') THEN ACT.FECHA_VISITA END) is not null 
 then (CASE WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') THEN ACT.FECHA_VISITA
                 WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)')  THEN ACT.FECHA_VISITA END)||ACT.AGENTE_WID  end Dias_Trabajados_Agentes,

 CASE  WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') AND ACT.PRODUCTO_REPORTE_WID = '-1' THEN ACT.ID_VISITA
       WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') AND ACT.PRODUCTO_REPORTE_WID = '-1' THEN ACT.ID_VISITA END  Visitas_Sin_Producto,
 CASE  WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') THEN ACT.AGENTE_WID
       WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') THEN ACT.AGENTE_WID END Agentes_Visitados,
  CASE WHEN AG.DIVISION IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Visita Remota (videollamada)') and ACT.FICHERO_FLAG = '1' THEN ACT.AGENTE_WID 
       WHEN AG.DIVISION NOT IN ('RED PLUS','RED NEO') AND ACT.TIPO_VISITA IN ('Visita Presencial', 'Llamada telefónica', 'Visita Remota (videollamada)') and ACT.FICHERO_FLAG = '1' THEN ACT.AGENTE_WID END Agentes_Visitados_Fichero,
ACT.NOMBRE_PROD_REP_MARCA Producto_Reporte,
