WITH o AS (SELECT ID_ORDER, SUM(U_GROSS) UB, SUM(A_NET) IMP FROM ANL_F_SELLIN
           WHERE ID_BU='ESP' AND DATE_CONFIRMATION >= DATE '2026-01-01' AND DATE_CONFIRMATION < DATE '2026-03-01'
           GROUP BY ID_ORDER),
c AS (SELECT ID_ORDER, SUM(UNIDADES_BRUTAS) UB, SUM(IMPORTE_NETO) IMP
      FROM ANL_ANALISIS_CAMAPAÑAS_ESP_TMP2 WHERE AÑO=2026 AND MES IN (1,2) AND DATA_SOURCE=1 GROUP BY ID_ORDER)
SELECT NVL(o.ID_ORDER,c.ID_ORDER) AS ID_ORDER, o.UB AS UB_ORIGEN, c.UB AS UB_VISTA, o.IMP AS IMP_ORIGEN, c.IMP AS IMP_VISTA
FROM o FULL OUTER JOIN c ON o.ID_ORDER=c.ID_ORDER
WHERE NVL(o.UB,0)<>NVL(c.UB,0) OR NVL(o.IMP,0)<>NVL(c.IMP,0);



SELECT ID_ORDER, ID_PRODUCT_CAT, IS_PACK, ID_ITM_PACK, ID_AGENT, ID_CAMPAIGN, ID_DELIVERYCLIENT,
       ID_ORDER_SUBTYPE, U_GROSS, A_NET
FROM ANL_F_SELLIN
WHERE ID_BU='ESP' AND ID_ORDER IN ('<p1>','<p2>','<p3>')
ORDER BY ID_ORDER, IS_PACK;



SELECT * FROM ANL_M_ESP_OBJ_CAMP_DEL
WHERE (ID_CAMP, ID_DELEGADO_JDE) IN (
   SELECT ID_CAMPAIGN, ID_AGENT FROM ANL_F_SELLIN
   WHERE ID_BU='ESP' AND ID_ORDER IN ('<p1>','<p2>','<p3>'))
ORDER BY ID_CAMP, ID_DELEGADO_JDE;
