WITH ll AS (
    SELECT ID_VISITA,
           MAX(CASE WHEN VISITAS IS NOT NULL THEN 1 ELSE 0 END)              AS CONTADA,
           MAX(CASE WHEN VISITAS_SIN_PRODUCTO IS NOT NULL THEN 1 ELSE 0 END) AS SIN_PRODUCTO,
           MAX(CASE WHEN IMPACTOS IS NOT NULL THEN 1 ELSE 0 END)             AS CON_IMPACTO,
           MAX(NVL(TO_CHAR(VISITA_CLM), '(null)'))                           AS VISITA_CLM
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND TIPO_VISITA = 'Llamada telefónica'
      AND ID_VISITA IS NOT NULL
      AND RED_NEGOCIO_VISITA IS NOT NULL
      AND RED_NEGOCIO_VISITA <> 'NA'
    GROUP BY ID_VISITA
)
SELECT CONTADA, SIN_PRODUCTO, CON_IMPACTO, VISITA_CLM,
       COUNT(*) AS N_LLAMADAS
FROM ll
GROUP BY CONTADA, SIN_PRODUCTO, CON_IMPACTO, VISITA_CLM
ORDER BY CONTADA, N_LLAMADAS DESC;


SELECT NVL(DIVISION, '(null)') AS DIVISION,
       MES,
       COUNT(DISTINCT CASE WHEN VISITAS IS NOT NULL THEN ID_VISITA END) AS CONTADAS,
       COUNT(DISTINCT CASE WHEN VISITAS IS NULL     THEN ID_VISITA END) AS NO_CONTADAS
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = '2026'
  AND TIPO_VISITA = 'Llamada telefónica'
  AND ID_VISITA IS NOT NULL
  AND RED_NEGOCIO_VISITA IS NOT NULL
  AND RED_NEGOCIO_VISITA <> 'NA'
GROUP BY DIVISION, MES
ORDER BY DIVISION, MES;
