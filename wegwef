WITH v AS (
    SELECT ID_VISITA,
           MAX(TIPO_VISITA)    AS TIPO_VISITA,
           MAX(SUBTIPO_VISITA) AS SUBTIPO_VISITA,
           MAX(CASE WHEN VISITAS IS NOT NULL THEN 1 ELSE 0 END) AS CONTADA,
           MAX(CASE WHEN RED_NEGOCIO_VISITA IS NOT NULL
                     AND RED_NEGOCIO_VISITA <> 'NA' THEN 1 ELSE 0 END) AS CON_RED
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND ID_VISITA IS NOT NULL
    GROUP BY ID_VISITA
)
SELECT NVL(TIPO_VISITA, '(null)')    AS TIPO_VISITA,
       NVL(SUBTIPO_VISITA, '(null)') AS SUBTIPO_VISITA,
       SUM(CONTADA)                  AS CONTADAS,
       SUM(1 - CONTADA)              AS NO_CONTADAS,
       SUM(CASE WHEN CON_RED = 0 THEN 1 ELSE 0 END) AS SIN_RED
FROM v
GROUP BY TIPO_VISITA, SUBTIPO_VISITA
ORDER BY NO_CONTADAS DESC;
