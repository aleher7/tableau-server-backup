    momento_tableau = None
    try:
        workbook_referencia = localizar_vista(servidor, config, informe_referencia)[1]
        momento_tableau = ultimo_refresco_tableau(servidor, workbook_referencia)
    except Exception as e:
        log.error("No se pudo comprobar la fecha en Tableau (via '%s'): %s",
                  informe_referencia['nombre'], e)
