SELECT NVL(TO_CHAR(RED_NEGOCIO_VISITA), '(null)') AS RED,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS F_TODOS,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND AÑO >= '2025'
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS F_DESDE_2025,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND AÑO >= '2024'
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS F_DESDE_2024,
       COUNT(DISTINCT CASE WHEN F_FICH_AGENTE_CONTACTO = 1 AND AÑO >= '2023'
             THEN TO_CHAR(AGENTE_WID) || TO_CHAR(CONTACTO_WID) END) AS F_DESDE_2023
FROM ANL_ACTIVIDAD_ESP
WHERE (   ID_VISITA IS NULL
       OR CONTACTO_WID IS NOT NULL
       OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY RED_NEGOCIO_VISITA
ORDER BY 1;
