SELECT f.NUM_PEDIDO, f.ID_ITM, f.DCTO_COMERCIAL AS final, c.esperado,
       f.DCTO_COMERCIAL - c.esperado AS diferencia
FROM (
  SELECT TO_CHAR(SDDOCO) || TO_CHAR(SDDCTO) AS NUM_PEDIDO, SDITM,
         SUM(SDSOQS/10000 * ALUPRC_DESC/10000 * (-1)) AS esperado
  FROM TMP_4_NDL_PED_CAMPOS
  WHERE SDKCOO = '00400'
    AND SDDCTO IN ('SO','SN','CC')
    AND ALUPRC_DESC IS NOT NULL
    AND TRIM(TIPO_DESC) NOT LIKE 'STADPP%'
    AND (SDADDJ <> 0 OR (SDADDJ = 0 AND SDIVD <> 0))
  GROUP BY TO_CHAR(SDDOCO) || TO_CHAR(SDDCTO), SDITM
) c
JOIN STD_NDL_PEDIDOS_NORM f
  ON f.NUM_PEDIDO = c.NUM_PEDIDO AND f.ID_ITM = c.SDITM
WHERE ABS(f.DCTO_COMERCIAL - c.esperado) > 0.01
ORDER BY ABS(f.DCTO_COMERCIAL - c.esperado) DESC;


SELECT SDLNID, SDITM, SDSOQS/10000 AS unidades, SDADDJ, SDIVD
FROM TMP_3_NMACST_F4211_F42119
WHERE SDKCOO='00400' AND TO_CHAR(SDDOCO)||TO_CHAR(SDDCTO) = '<num_pedido>'
  AND SDITM = <id_itm>;
