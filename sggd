WITH base AS (
    SELECT DIVISION,
           NVL(TO_CHAR(ESTATUS_ESPECIALIDAD), '(null)') AS ESTATUS_ESPECIALIDAD,
           NVL(TO_CHAR(ESPECIALIDAD_RESUMEN), '(null)') AS ESPECIALIDAD_RESUMEN,
           IMPACTOS,
           AÑO
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO >= '2024'                                   -- alcance de datos de Tableau
      AND (   ID_VISITA IS NULL                           -- Filtro Contacto No nulo
           OR CONTACTO_WID IS NOT NULL
           OR DIVISION IS NULL
           OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      AND DIVISION IN ('RED CARE','RED DERM','RED SELECT','RED SKIN','FORMACIÓN')  -- Filtro Impactos
      -- aquí los filtros de la hoja con valores marcados (ZONA, AGENTE, etc.)
),
detalle AS (
    SELECT DIVISION, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN,
           COUNT(DISTINCT CASE WHEN AÑO = '2026' THEN IMPACTOS END) AS IMP
    FROM base
    GROUP BY DIVISION, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN
),
tot_fila AS (
    SELECT DIVISION,
           COUNT(DISTINCT CASE WHEN AÑO = '2026' THEN IMPACTOS END) AS IMP_FILA
    FROM base
    GROUP BY DIVISION
),
tot_col AS (
    SELECT ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN,
           COUNT(DISTINCT CASE WHEN AÑO = '2026' THEN IMPACTOS END) AS IMP_COL
    FROM base
    GROUP BY ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN
),
tot_general AS (
    SELECT COUNT(DISTINCT CASE WHEN AÑO = '2026' THEN IMPACTOS END) AS IMP_TOTAL
    FROM base
)
SELECT d.DIVISION,
       d.ESTATUS_ESPECIALIDAD,
       d.ESPECIALIDAD_RESUMEN,
       d.IMP,
       ROUND(100 * d.IMP / NULLIF(c.IMP_COL, 0), 1)  AS PCT_IMP_V,
       ROUND(100 * d.IMP / NULLIF(f.IMP_FILA, 0), 1) AS PCT_IMP_H
FROM detalle d
JOIN tot_fila f ON f.DIVISION = d.DIVISION
JOIN tot_col  c ON c.ESTATUS_ESPECIALIDAD = d.ESTATUS_ESPECIALIDAD
               AND c.ESPECIALIDAD_RESUMEN = d.ESPECIALIDAD_RESUMEN

UNION ALL

SELECT f.DIVISION, 'TOTAL', 'TOTAL',
       f.IMP_FILA,
       ROUND(100 * f.IMP_FILA / NULLIF(g.IMP_TOTAL, 0), 1),
       100
FROM tot_fila f
CROSS JOIN tot_general g
ORDER BY 1, 2, 3;
