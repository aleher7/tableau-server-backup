-- BU y compañía por año en el origen
SELECT 1900 + TRUNC(SDADDJ / 1000) AS ANIO,
       SDKCOO                      AS COMPANIA,
       TRIM(SDMCU)                 AS BU,
       COUNT(*)                    AS FILAS,
       COUNT(DISTINCT SDDOCO)      AS PEDIDOS
FROM TMP_3_NMACST_F4211_F421x
WHERE SDADDJ >= 124000
GROUP BY 1900 + TRUNC(SDADDJ / 1000), SDKCOO, TRIM(SDMCU)
ORDER BY 1, 2, 3;


-- NDL en el origen
SELECT COUNT(*)               AS FILAS_ORIGEN,
       COUNT(DISTINCT SDDOCO) AS PEDIDOS_ORIGEN
FROM TMP_3_NMACST_F4211_F421x
WHERE TRIM(SDMCU) = 'XXXX';

-- NDL en la tabla final (solo si STD_NM_PEDIDOS tiene la BU; si no, esta consulta fallará)
SELECT COUNT(*)                AS FILAS_FINAL,
       COUNT(DISTINCT PEDIDO)  AS PEDIDOS_FINAL
FROM STD_NM_PEDIDOS
WHERE TRIM(SDMCU) = 'XXXX';
