SELECT LISTAGG(PEDIDO, ',') WITHIN GROUP (ORDER BY PEDIDO) AS lista
FROM (
  SELECT DISTINCT PEDIDO FROM (
    SELECT SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID FROM STD_NM_PEDIDOS
    GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID HAVING COUNT(*) > 1)
  FETCH FIRST 10 ROWS ONLY
  UNION
  SELECT PEDIDO FROM (SELECT DISTINCT PEDIDO FROM STD_NM_PEDIDOS
    WHERE PEDIDO NOT IN (SELECT PEDIDO FROM STD_NM_PEDIDOS
        GROUP BY SDKCOO, PEDIDO, TIPO_PEDIDO, SDLNID HAVING COUNT(*) > 1)
    ORDER BY DBMS_RANDOM.VALUE)
  WHERE ROWNUM <= 10
);
