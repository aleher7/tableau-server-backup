SELECT i.BUSINESS_UNIT, COUNT(DISTINCT i.CODIGO_CORTO) sin_referencia
FROM   ANL_CDM_INVENTARIO i
JOIN   CLABS_STG_PRO.STG_JDE_IFCSA_F55CVMAE_PIVOT p
       ON TRIM(TO_CHAR(p.COD_CORTO_PROD)) = TRIM(TO_CHAR(i.CODIGO_CORTO))
WHERE  i.BUSINESS_UNIT IN ('CLABS MEXICO','CLABS PORTUGAL')
  AND  NOT EXISTS (SELECT 1 FROM ANL_CDM_INVENTARIO o
                   WHERE o.CODIGO_CORTO = i.CODIGO_CORTO
                     AND NVL(o.BUSINESS_UNIT,'X') NOT IN ('CLABS MEXICO','CLABS PORTUGAL'))
GROUP BY i.BUSINESS_UNIT;




SELECT DISTINCT i.BUSINESS_UNIT, i.CODIGO_CORTO,
       i.LOCAL_PRODUCT_NAME nombre_bu_dudosa,
       c.BUSINESS_UNIT      bu_catalogo,
       c.LOCAL_PRODUCT_NAME nombre_catalogo
FROM   ANL_CDM_INVENTARIO i
JOIN   CLABS_STG_PRO.STG_JDE_IFCSA_F55CVMAE_PIVOT p
       ON TRIM(TO_CHAR(p.COD_CORTO_PROD)) = TRIM(TO_CHAR(i.CODIGO_CORTO))
LEFT JOIN anl_m_prod_catalog_local c
       ON TRIM(TO_CHAR(c.LOCAL_PRODUCT_CODE)) = TRIM(TO_CHAR(i.CODIGO_CORTO))
      AND NVL(c.BUSINESS_UNIT,'X') NOT IN ('CLABS MEXICO','CLABS PORTUGAL')
WHERE  i.BUSINESS_UNIT IN ('CLABS MEXICO','CLABS PORTUGAL')
  AND  NOT EXISTS (SELECT 1 FROM ANL_CDM_INVENTARIO o
                   WHERE o.CODIGO_CORTO = i.CODIGO_CORTO
                     AND NVL(o.BUSINESS_UNIT,'X') NOT IN ('CLABS MEXICO','CLABS PORTUGAL'))
ORDER BY 1, 2;
