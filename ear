WITH base AS (
    SELECT DIVISION, PRODUCTO_REPORTE, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN, IMPACTOS
    FROM ANL_ACTIVIDAD_ESP
    WHERE AÑO = '2026'
      AND IMPACTOS IS NOT NULL
      -- resto de filtros de la hoja de Tableau (ESPECIALIDAD_PRINCIPAL, ZONA, etc.)
),
detalle AS (            -- Imp de cada celda
    SELECT DIVISION, PRODUCTO_REPORTE, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN,
           COUNT(DISTINCT IMPACTOS) AS IMP
    FROM base
    GROUP BY DIVISION, PRODUCTO_REPORTE, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN
),
tot_fila AS (           -- denominador de % Imp H (Tabla a lo largo): cada fila
    SELECT DIVISION, PRODUCTO_REPORTE,
           COUNT(DISTINCT IMPACTOS) AS IMP_FILA
    FROM base
    GROUP BY DIVISION, PRODUCTO_REPORTE
),
tot_panel AS (          -- denominador de % Imp V (Panel hacia abajo): cada red + columna
    SELECT DIVISION, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN,
           COUNT(DISTINCT IMPACTOS) AS IMP_PANEL
    FROM base
    GROUP BY DIVISION, ESTATUS_ESPECIALIDAD, ESPECIALIDAD_RESUMEN
),
tot_red AS (            -- denominador de % Imp V en la columna Total
    SELECT DIVISION,
           COUNT(DISTINCT IMPACTOS) AS IMP_RED
    FROM base
    GROUP BY DIVISION
)
-- Celdas por estatus / especialidad
SELECT d.DIVISION,
       d.PRODUCTO_REPORTE,
       d.ESTATUS_ESPECIALIDAD,
       d.ESPECIALIDAD_RESUMEN,
       d.IMP,
       ROUND(100 * d.IMP / NULLIF(p.IMP_PANEL, 0), 1) AS PCT_IMP_V,
       ROUND(100 * d.IMP / NULLIF(f.IMP_FILA, 0), 1)  AS PCT_IMP_H
FROM detalle d
JOIN tot_fila  f ON f.DIVISION = d.DIVISION
                AND f.PRODUCTO_REPORTE = d.PRODUCTO_REPORTE
JOIN tot_panel p ON p.DIVISION = d.DIVISION
                AND p.ESTATUS_ESPECIALIDAD = d.ESTATUS_ESPECIALIDAD
                AND p.ESPECIALIDAD_RESUMEN = d.ESPECIALIDAD_RESUMEN

UNION ALL

-- Columna "Total"
SELECT f.DIVISION,
       f.PRODUCTO_REPORTE,
       'TOTAL',
       'TOTAL',
       f.IMP_FILA,
       ROUND(100 * f.IMP_FILA / NULLIF(r.IMP_RED, 0), 1),
       100
FROM tot_fila f
JOIN tot_red  r ON r.DIVISION = f.DIVISION

ORDER BY 1, 2, 3, 4;
