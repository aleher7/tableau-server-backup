SELECT COLUMN_NAME FROM ALL_TAB_COLUMNS
WHERE OWNER = 'CLABS_ANL_PRO' AND TABLE_NAME = 'ANL_ACTIVIDAD_ESP' ORDER BY COLUMN_ID;



SELECT DIVISION,
       COUNT(DISTINCT VISITAS) AS visitas,
       COUNT(DISTINCT IMPACTOS) AS impactos
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY DIVISION
ORDER BY 1;


SELECT COUNT(DISTINCT IMPACTOS) AS impactos_formacion_sin_contacto
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND DIVISION = 'FORMACIÓN'
  AND CONTACTO_WID IS NULL
  AND IMPACTOS IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'));



SELECT DIVISION, COUNT(DISTINCT IMPACTOS) AS impactos
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND RED_NEGOCIO_VISITA IS NULL
  AND IMPACTOS IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY DIVISION
ORDER BY 1;



SELECT RED_NEGOCIO_VISITA, COUNT(DISTINCT IMPACTOS) AS impactos
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND IMPACTOS IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY RED_NEGOCIO_VISITA
ORDER BY 1;



SELECT MAX(DATE_UPD) AS ultima_carga,
       MAX(FECHA_VISITA) AS ultima_visita,
       SYSDATE AS ahora
FROM ANL_ACTIVIDAD_ESP
WHERE ID_VISITA IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'));


SELECT COUNT(*) AS agentes_con_mas_de_1_division
FROM (SELECT AGENTE_WID
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY AGENTE_WID
      HAVING COUNT(DISTINCT DIVISION) > 1);



SELECT nredes, COUNT(*) AS agentes
FROM (SELECT AGENTE_WID, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO >= 2024
        AND ID_VISITA IS NOT NULL
        AND RED_NEGOCIO_VISITA <> 'NA'
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY AGENTE_WID)
GROUP BY nredes
ORDER BY 1;



SELECT DIVISION,
       COUNT(DISTINCT ID_VISITA) AS visitas,
       COUNT(DISTINCT CASE WHEN UPPER(RED_NEGOCIO_VISITA) <> DIVISION THEN ID_VISITA END) AS red_distinta_de_division
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND ID_VISITA IS NOT NULL
  AND CONTACTO_WID IS NOT NULL
  AND RED_NEGOCIO_VISITA <> 'NA'
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY DIVISION
ORDER BY 1;



SELECT COUNT(CASE WHEN VISITAS_FICHERO IS NOT NULL AND F_FICH_AGENTE_CONTACTO = 0
                  THEN 1 END) AS marca_actividad_sin_fichero,
       COUNT(CASE WHEN VISITAS IS NOT NULL AND VISITAS_FICHERO IS NULL AND F_FICH_AGENTE_CONTACTO = 1
                  THEN 1 END) AS fichero_sin_marca_actividad
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024
  AND ID_VISITA IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'));



SELECT SUM(nredes - 1) AS dias_repetidos
FROM (SELECT DIAS_TRABAJADOS_AGENTES, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO = 2026
        AND DIAS_TRABAJADOS_AGENTES IS NOT NULL
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY DIAS_TRABAJADOS_AGENTES
      HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1);


SELECT SUM(nredes - 1) AS contactos_repetidos
FROM (SELECT CONTACTOS_VISITADOS, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE AÑO = 2026
        AND CONTACTOS_VISITADOS IS NOT NULL
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY CONTACTOS_VISITADOS
      HAVING COUNT(DISTINCT RED_NEGOCIO_VISITA) > 1);



SELECT DIVISION, TIPO_VISITA, COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO = 2026
  AND ID_VISITA IS NOT NULL
  AND CONTACTO_WID IS NULL
  AND DIVISION IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE')
GROUP BY DIVISION, TIPO_VISITA
ORDER BY 1, 2;



SELECT RED_NEGOCIO_VISITA, COUNT(DISTINCT ID_VISITA) AS visitas
FROM ANL_ACTIVIDAD_ESP
WHERE AÑO >= 2024
  AND DIVISION = 'FORMACIÓN'
  AND ID_VISITA IS NOT NULL
  AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
       OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
GROUP BY RED_NEGOCIO_VISITA
ORDER BY 1;



SELECT nredes, COUNT(*) AS productos
FROM (SELECT PRODUCTO_REPORTE, COUNT(DISTINCT RED_NEGOCIO_VISITA) AS nredes
      FROM ANL_ACTIVIDAD_ESP
      WHERE ID_VISITA IS NOT NULL
        AND IMPACTOS IS NOT NULL
        AND RED_NEGOCIO_VISITA <> 'NA'
        AND (ID_VISITA IS NULL OR CONTACTO_WID IS NOT NULL OR DIVISION IS NULL
             OR DIVISION NOT IN ('RED NEO','RED PLUS','RED SKIN','RED DERM','RED CARE'))
      GROUP BY PRODUCTO_REPORTE)
GROUP BY nredes
ORDER BY 1;
