SELECT c.constraint_name, c.constraint_type, cc.column_name, cc.position
FROM all_constraints c
JOIN all_cons_columns cc ON cc.constraint_name = c.constraint_name AND cc.owner = c.owner
WHERE c.table_name = 'STD_NM_PEDIDOS' AND c.constraint_type IN ('P','U')
ORDER BY c.constraint_name, cc.position;
