SELECT F.ID_ORDER, F.<AGENTE>, COUNT(DISTINCT F.ID_ORDER_LINE) LINEAS,
       (SELECT COUNT(*)
        FROM ANL_M_ESP_OBJ_CAMP_DEL O
        WHERE O.<CAMPAÑA> = 'CYC125'
          AND O.<AGENTE>  = F.<AGENTE>) AS FILAS_EN_OBJETIVO
FROM ANL_F_SELLIN F
WHERE F.ID_BU = 'ESP'
  AND F.ID_CAMPAIGN = 'CYC125'
  AND F.ID_ORDER IN ('25107862SO','25103285SO','25083608SO')
GROUP BY F.ID_ORDER, F.<AGENTE>;
