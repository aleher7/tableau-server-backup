SELECT 'ORIGEN' AS FUENTE, SUM(U_GROSS) AS UB, SUM(A_NET) AS IMP
FROM ANL_F_SELLIN
WHERE ID_BU='ESP' AND EXTRACT(YEAR FROM DATE_CONFIRMATION)=2026 AND IS_PACK IN (0,2)
UNION ALL
SELECT 'CAMPAÑAS_REAL', SUM(UNIDADES_BRUTAS), SUM(IMPORTE_NETO)
FROM "ANL_ANALISIS_CAMPAÑAS_ESP" WHERE AÑO=2026 AND IS_PACK IN (0,2) AND DATA_SOURCE=1
UNION ALL
SELECT 'CAMPAÑAS_TMP', SUM(UNIDADES_BRUTAS), SUM(IMPORTE_NETO)
FROM TMP_CAMP_NEW WHERE AÑO=2026 AND IS_PACK IN (0,2) AND DATA_SOURCE=1;




SELECT NVL(o.MES,c.MES) AS MES, NVL(o.IS_PACK,c.IS_PACK) AS IS_PACK,
       NVL(o.UB,0)-NVL(c.UB,0) AS DIF_UB, NVL(o.IMP,0)-NVL(c.IMP,0) AS DIF_IMP
FROM (SELECT EXTRACT(MONTH FROM DATE_CONFIRMATION) AS MES, IS_PACK,
             SUM(U_GROSS) UB, SUM(A_NET) IMP
      FROM ANL_F_SELLIN WHERE ID_BU='ESP' AND EXTRACT(YEAR FROM DATE_CONFIRMATION)=2026
      GROUP BY EXTRACT(MONTH FROM DATE_CONFIRMATION), IS_PACK) o
FULL OUTER JOIN
     (SELECT MES, IS_PACK, SUM(UNIDADES_BRUTAS) UB, SUM(IMPORTE_NETO) IMP
      FROM "ANL_ANALISIS_CAMPAÑAS_ESP" WHERE AÑO=2026 AND DATA_SOURCE=1 GROUP BY MES, IS_PACK) c
  ON o.MES=c.MES AND o.IS_PACK=c.IS_PACK
WHERE NVL(o.UB,0)<>NVL(c.UB,0) OR NVL(o.IMP,0)<>NVL(c.IMP,0)
ORDER BY 1,2;
