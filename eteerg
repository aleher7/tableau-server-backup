SELECT RED_NEGOCIO_VISITA, F_FICH_AGENTE_CONTACTO, ESTADO_AGENTE,
       CASE WHEN ID_VISITA IS NULL THEN 'sin visita' ELSE 'con visita' END AS tipo_fila,
       COUNT(*) AS filas
FROM ANL_ACTIVIDAD_ESP
WHERE AGENTE_WID = <id> AND AÑO >= 2024
GROUP BY RED_NEGOCIO_VISITA, F_FICH_AGENTE_CONTACTO, ESTADO_AGENTE,
         CASE WHEN ID_VISITA IS NULL THEN 'sin visita' ELSE 'con visita' END
ORDER BY 1;
